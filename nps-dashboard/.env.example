# ---- Wajib untuk produksi ----

# API key Tally (Settings → API). Hanya dipakai server-side.
TALLY_API_KEY=

# Kunci acak untuk menandatangani cookie sesi. Buat dengan: openssl rand -hex 32
AUTH_SECRET=

# Kata sandi halaman admin Incentric. Boleh beberapa, pisahkan dengan koma.
ADMIN_PASSWORD=

# Kata sandi per client. Boleh beberapa, pisahkan dengan koma.
NPS_PASSWORD_RSANANDA=

# Form ID Tally per client (opsional, default ada di src/lib/config.ts).
NPS_FORM_RSANANDA=yPW566

# ---- Opsional ----

# 1 = pakai data contoh di src/fixtures, tanpa memanggil Tally.
NPS_DEMO=0

# Lama cache data Tally dalam detik (default 300).
NPS_CACHE_TTL_SECONDS=300
