---
import Base from '../../layouts/Base.astro';
import { isAdmin, sessionCookie, verifySessionToken } from '../../lib/auth';
import { addCatalogEntry, deleteCatalogEntry, listCustomCatalog } from '../../lib/catalog';
import { hasDatabase } from '../../lib/db';
import { QUESTIONS } from '../../lib/config';

export const prerender = false;

const session = await verifySessionToken(Astro.cookies.get(sessionCookie.name)?.value);
if (!isAdmin(session)) return Astro.redirect('/admin');

const dbReady = hasDatabase();
let notice: string | null = null;
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  if (intent === 'add') {
    const result = await addCatalogEntry({
      label: String(form.get('label') ?? ''),
      keywords: String(form.get('keywords') ?? ''),
      stageHint: String(form.get('stageHint') ?? '') || null,
    });
    if (result.ok) notice = 'Catalog entry saved.';
    else error = result.error ?? 'Could not save.';
  }

  if (intent === 'delete') {
    await deleteCatalogEntry(Number(form.get('id') ?? 0));
    notice = 'Catalog entry removed.';
  }
}

const custom = await listCustomCatalog();
const builtIn = QUESTIONS.map((question) => ({ label: question.label, keywords: question.titleKeywords }));
---

<Base title="Label catalog - Incentric">
  <div class="shell">
    <header class="border-b border-slate-300 bg-white">
      <div class="container-page flex items-center justify-between gap-4 py-4">
        <a href="/" class="flex items-center gap-3">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-ink text-base font-extrabold text-brand-yellow">i</span>
          <span class="text-sm font-extrabold uppercase tracking-[0.24em]">incentric</span>
        </a>
        <div class="flex items-center gap-2">
          <a href="/admin" class="btn btn-outline !min-h-10 !px-4">Projects</a>
          <form method="POST" action="/api/logout"><button class="btn btn-dark !min-h-10 !px-4">Sign out</button></form>
        </div>
      </div>
    </header>

    <main class="container-page max-w-5xl space-y-8 py-10">
      <div>
        <p class="kicker">Admin</p>
        <h1 class="display mt-3">Label catalog</h1>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-500">
          When a Tally form is read, question titles are matched against this catalog to suggest a
          short label. Add keywords for new sectors (F&amp;B, retail, hospitality) so new clients need
          less manual editing.
        </p>
      </div>

      {!dbReady && (
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-relaxed text-amber-900">
          <strong class="font-extrabold">Database not connected.</strong> Custom entries need Postgres.
          Built-in keywords still work.
        </div>
      )}

      {notice && <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-semibold text-emerald-900">{notice}</div>}
      {error && <div class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-semibold text-rose-900">{error}</div>}

      <section class="card">
        <p class="card-title">Add keyword set</p>
        <h2 class="card-heading">Teach the system a new label</h2>
        <form method="POST" class="mt-5 grid gap-3 sm:grid-cols-[1fr_1.6fr_auto]">
          <input type="hidden" name="intent" value="add" />
          <label class="block">
            <span class="stat-label">Short label</span>
            <input name="label" required class="field mt-1.5" placeholder="Signage" />
          </label>
          <label class="block">
            <span class="stat-label">Keywords (comma separated)</span>
            <input name="keywords" required class="field mt-1.5" placeholder="signage, sign, penunjuk arah" />
          </label>
          <button type="submit" class="btn btn-primary self-end" disabled={!dbReady}>Save label</button>
        </form>
        <p class="prose-note mt-3">
          Matching is case-insensitive and looks for the keyword anywhere in the question title.
          The longest matching keyword wins.
        </p>
      </section>

      <section class="card">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-lg font-extrabold">Custom labels</h2>
          <span class="badge badge-muted">{custom.length} entries</span>
        </div>

        {custom.length === 0 ? (
          <p class="prose-note mt-4">No custom labels yet. Built-in keywords are used.</p>
        ) : (
          <div class="table-wrap mt-4">
            <table class="data-table !min-w-0">
              <thead>
                <tr><th>Label</th><th>Keywords</th><th>Added</th><th></th></tr>
              </thead>
              <tbody>
                {custom.map((entry) => (
                  <tr>
                    <td class="font-bold">{entry.label}</td>
                    <td class="text-[12px] text-slate-600">{entry.keywords.join(', ')}</td>
                    <td class="text-[12px] text-slate-500">{entry.createdAt.slice(0, 10)}</td>
                    <td class="text-right">
                      <form method="POST">
                        <input type="hidden" name="intent" value="delete" />
                        <input type="hidden" name="id" value={entry.id} />
                        <button type="submit" class="btn btn-outline !min-h-8 !px-3 !text-[11px]">Remove</button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <section class="card">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-lg font-extrabold">Built-in labels</h2>
          <span class="badge badge-muted">{builtIn.length} entries</span>
        </div>
        <p class="prose-note mt-2">Shipped with the dashboard for hospital and clinic surveys.</p>
        <div class="table-wrap mt-4">
          <table class="data-table !min-w-0">
            <thead>
              <tr><th>Label</th><th>Keywords</th></tr>
            </thead>
            <tbody>
              {builtIn.map((entry) => (
                <tr>
                  <td class="font-bold">{entry.label}</td>
                  <td class="text-[12px] text-slate-600">{entry.keywords.join(', ')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>
</Base>
