---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { isAdmin, sessionCookie, verifySessionToken } from '../../lib/auth';
import { connectClient } from '../../lib/admin-actions';
import { hasDatabase } from '../../lib/db';
import { readEnv } from '../../lib/env';

export const prerender = false;

const session = await verifySessionToken(Astro.cookies.get(sessionCookie.name)?.value);
if (!isAdmin(session)) return Astro.redirect('/admin');

const dbReady = hasDatabase();
let result: Awaited<ReturnType<typeof connectClient>> | null = null;
let name = '';
let formId = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  name = String(form.get('name') ?? '');
  formId = String(form.get('formId') ?? '');

  result = await connectClient({
    name,
    formId,
    apiKey: readEnv('TALLY_API_KEY') ?? '',
    npsScale: String(form.get('npsScale') ?? '1-5') === '0-10' ? '0-10' : '1-5',
  });
}

const site = Astro.url.origin;
---

<Base title="New Client - Incentric">
  <div class="shell">
    <SiteHeader
      tone="light"
      homeHref="/admin"
      clientName="New project"
      links={[{ label: 'Projects', href: '/admin' }]}
      showSignOut
    />

    <main class="container-page max-w-3xl space-y-6 pb-14 pt-24 md:pt-32">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-brand-blue">New project</p>
        <h1 class="mt-3 text-3xl font-extrabold tracking-tight md:text-4xl">Connect a Tally form</h1>
        <p class="mt-3 text-sm leading-relaxed text-slate-500">
          Duplicate the Tally template, then paste the form ID here. The dashboard is generated
          automatically from the form headings and scored questions.
        </p>
      </div>

      {!dbReady && (
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-relaxed text-amber-900">
          <strong class="font-extrabold">Database not connected.</strong> Add Postgres from the Vercel
          Marketplace first, then connect it to this project.
        </div>
      )}

      {result && !result.ok && (
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-semibold leading-relaxed text-rose-900">
          {result.error}
        </div>
      )}

      {result && result.ok ? (
        <section class="card">
          <p class="card-title">Project created</p>
          <h2 class="card-heading">{result.name}</h2>
          <dl class="mt-5 grid gap-3 sm:grid-cols-2">
            <div class="rounded-lg bg-slate-50 p-3">
              <dt class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Dashboard</dt>
              <dd class="mt-1 break-all text-sm font-bold text-brand-blue">{site}/{result.slug}</dd>
            </div>
            <div class="rounded-lg bg-slate-50 p-3">
              <dt class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Client login</dt>
              <dd class="mt-1 break-all text-sm font-bold text-brand-blue">{site}/login/{result.slug}</dd>
            </div>
            <div class="rounded-lg bg-slate-50 p-3">
              <dt class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Password</dt>
              <dd class="mt-1 font-mono text-sm font-bold">{result.password}</dd>
            </div>
            <div class="rounded-lg bg-slate-50 p-3">
              <dt class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Generated</dt>
              <dd class="mt-1 text-sm font-bold">{result.stages} stages · {result.questions} scored questions</dd>
            </div>
          </dl>
          <p class="prose-note mt-4">
            Copy the password now. It is stored only as a hash and cannot be shown again.
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            <a href={`/${result.slug}`} class="btn btn-primary">Open dashboard</a>
            <a href="/admin" class="btn btn-outline">Back to projects</a>
          </div>
        </section>
      ) : (
        <form method="POST" class="card space-y-4">
          <label class="block">
            <span class="mb-1.5 block text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">Client name</span>
            <input name="name" required class="field" placeholder="RSU Ananda Srengat" value={name} />
          </label>
          <label class="block">
            <span class="mb-1.5 block text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">Tally form ID</span>
            <input name="formId" required class="field font-mono" placeholder="yPW566" value={formId} />
            <span class="prose-note mt-1 block">Found in the form URL: tally.so/r/<strong>yPW566</strong></span>
          </label>
          <label class="block">
            <span class="mb-1.5 block text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">NPS scale</span>
            <select name="npsScale" class="field">
              <option value="1-5">1 to 5 (5 = promoter)</option>
              <option value="0-10">0 to 10 (9-10 = promoter)</option>
            </select>
          </label>
          <button type="submit" class="btn btn-primary" disabled={!dbReady}>Connect and create dashboard</button>
        </form>
      )}
    </main>
  </div>
</Base>
