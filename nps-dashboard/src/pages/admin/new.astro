---
import Base from '../../layouts/Base.astro';
import { isAdmin, sessionCookie, verifySessionToken } from '../../lib/auth';
import { createSyncPreview, commitSync } from '../../lib/admin-actions';
import { hasDatabase } from '../../lib/db';

export const prerender = false;

const session = await verifySessionToken(Astro.cookies.get(sessionCookie.name)?.value);
if (!isAdmin(session)) return Astro.redirect('/admin');

const dbReady = hasDatabase();

let message: string | null = null;
let error: string | null = null;
let preview: Awaited<ReturnType<typeof createSyncPreview>> | null = null;
let submittedName = '';
let submittedFormId = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  submittedName = String(form.get('name') ?? '');
  submittedFormId = String(form.get('formId') ?? '');

  try {
    if (intent === 'preview') {
      preview = await createSyncPreview({ name: submittedName, formId: submittedFormId });
    } else if (intent === 'save') {
      const stageBase = JSON.parse(String(form.get('stages') ?? '[]')) as { key: string; label: string }[];
      const stages = stageBase.map((stage) => {
        const edited = form.get(`stage-label-${stage.key}`);
        return {
          key: stage.key,
          label: typeof edited === 'string' && edited.trim() ? edited.trim() : stage.label,
        };
      });

      const questionBase = JSON.parse(String(form.get('questions') ?? '[]')) as {
        questionId: string;
        label: string;
        stageKey: string | null;
        isScore: boolean;
        isNps: boolean;
        title: string;
      }[];

      const questions = questionBase.map((question) => {
        const label = form.get(`label-${question.questionId}`);
        const stage = form.get(`stage-${question.questionId}`);
        return {
          ...question,
          label: typeof label === 'string' && label.trim() ? label.trim() : question.label,
          stageKey: typeof stage === 'string' && stage.trim() ? stage.trim() : null,
        };
      });

      const result = await commitSync({
        name: submittedName,
        formId: submittedFormId,
        slug: String(form.get('slug') ?? ''),
        password: String(form.get('password') ?? ''),
        npsScale: String(form.get('npsScale') ?? '1-5') === '0-10' ? '0-10' : '1-5',
        stages,
        questions,
        unknownCount: 0,
      });

      if (result.ok) message = `Client saved. Dashboard is available at /${result.slug}`;
      else error = result.error ?? 'Failed to save the client.';
    }
  } catch (err) {
    error = err instanceof Error ? err.message : 'Something went wrong.';
  }
}
---

<Base title="Add Client - Incentric NPS">
  <div class="shell">
    <header class="border-b border-slate-200 bg-white">
      <div class="container-page flex items-center justify-between gap-4 py-4">
        <a href="/" class="flex items-center gap-3">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-ink text-base font-extrabold text-brand-yellow">i</span>
          <span class="text-sm font-extrabold uppercase tracking-[0.2em]">incentric</span>
        </a>
        <div class="flex items-center gap-2">
          <a href="/admin" class="btn btn-outline !min-h-10 !px-4">Clients</a>
          <form method="POST" action="/api/logout"><button class="btn btn-dark !min-h-10 !px-4">Sign out</button></form>
        </div>
      </div>
    </header>

    <main class="container-page max-w-5xl space-y-6 py-8">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-brand-blue">Admin</p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight">Add a New Client</h1>
        <p class="mt-2 text-sm leading-relaxed text-slate-500">
          Enter the client name and Tally form ID. Headings become service stages; scored questions
          become dashboard items with a short label.
        </p>
      </div>

      {!dbReady && (
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-relaxed text-amber-900">
          <strong class="font-extrabold">Database not connected.</strong>
          Add a Postgres database from the Vercel Marketplace and connect it to this project first.
        </div>
      )}

      {message && <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-semibold text-emerald-900">{message}</div>}
      {error && <div class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-semibold text-rose-900">{error}</div>}

      {!preview && (
        <form method="POST" class="card space-y-4">
          <input type="hidden" name="intent" value="preview" />
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1.5 block text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">Client name</span>
              <input name="name" required class="field" placeholder="RS Sehat Sentosa" value={submittedName} />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">Tally form ID</span>
              <input name="formId" required class="field" placeholder="yPW566" value={submittedFormId} />
            </label>
          </div>
          <button type="submit" class="btn btn-primary">Read form structure</button>
        </form>
      )}

      {preview && (
        <form method="POST" class="space-y-5">
          <input type="hidden" name="intent" value="save" />
          <input type="hidden" name="name" value={preview.name} />
          <input type="hidden" name="formId" value={preview.formId} />
          <input type="hidden" name="stages" value={JSON.stringify(preview.stages)} />
          <input type="hidden" name="questions" value={JSON.stringify(preview.questions)} />

          <section class="card">
            <h2 class="text-lg font-extrabold">Client details</h2>
            <div class="mt-4 grid gap-4 sm:grid-cols-3">
              <label class="block">
                <span class="mb-1.5 block text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">URL slug</span>
                <input name="slug" value={preview.slug} required class="field" />
              </label>
              <label class="block">
                <span class="mb-1.5 block text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">Client password</span>
                <input name="password" required minlength="8" class="field" placeholder="min. 8 characters" />
              </label>
              <label class="block">
                <span class="mb-1.5 block text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">NPS scale</span>
                <select name="npsScale" class="field">
                  <option value="1-5">1 to 5 (5 = promoter)</option>
                  <option value="0-10">0 to 10 (9-10 = promoter)</option>
                </select>
              </label>
            </div>
          </section>

          <section class="card">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="text-lg font-extrabold">Service stages</h2>
              <span class="badge badge-muted">{preview.stages.length} stages</span>
            </div>
            <p class="prose-note mt-2">Rename a stage if the client uses different wording. Keys stay fixed.</p>
            <ul class="mt-3 grid gap-2 sm:grid-cols-2">
              {preview.stages.map((stage) => (
                <li class="flex items-center gap-2 rounded-lg bg-slate-50 px-3 py-2">
                  <input
                    name={`stage-label-${stage.key}`}
                    value={stage.label}
                    class="field !h-9 flex-1 !text-[13px] !font-bold"
                    aria-label={`Label for stage ${stage.key}`}
                  />
                  <code class="text-[11px] text-slate-500">{stage.key}</code>
                </li>
              ))}
            </ul>
            {preview.stages.length === 0 && (
              <p class="mt-3 text-sm text-rose-600">No headings found. Add Heading blocks in Tally to group questions into stages.</p>
            )}
          </section>

          <section class="card">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="text-lg font-extrabold">Questions</h2>
              <span class="badge badge-muted">{preview.questions.length} items</span>
            </div>
            <p class="prose-note mt-2">Adjust the short label and stage for each scored question.</p>
            <div class="table-wrap mt-4">
              <table class="data-table">
                <thead>
                  <tr><th>Question in Tally</th><th>Short label</th><th>Stage</th><th>Type</th></tr>
                </thead>
                <tbody>
                  {preview.questions.map((question) => (
                    <tr>
                      <td class="max-w-[320px] text-[12px] leading-snug text-slate-600">{question.title}</td>
                      <td>
                        <input
                          name={`label-${question.questionId}`}
                          value={question.label}
                          class="field !h-9 !text-[12px]"
                          disabled={!question.isScore}
                        />
                      </td>
                      <td>
                        <select name={`stage-${question.questionId}`} class="field !h-9 !text-[12px]" disabled={!question.isScore}>
                          <option value="">None</option>
                          {preview.stages.map((stage) => (
                            <option value={stage.key} selected={stage.key === question.stageKey}>{stage.label}</option>
                          ))}
                        </select>
                      </td>
                      <td>
                        {question.isNps
                          ? <span class="badge badge-good">NPS</span>
                          : question.isScore
                            ? <span class="badge badge-muted">Score</span>
                            : <span class="badge badge-muted">Info</span>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <div class="flex flex-wrap items-center gap-3">
            <button type="submit" class="btn btn-primary" disabled={!dbReady}>Save client</button>
            <a href="/admin/new" class="btn btn-outline">Back</a>
          </div>
        </form>
      )}
    </main>
  </div>
</Base>
