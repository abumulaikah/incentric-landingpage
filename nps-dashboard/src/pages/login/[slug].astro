---
import Base from '../../layouts/Base.astro';
import { getClient } from '../../lib/config';
import {
  checkClientPassword,
  cookieOptionsFor,
  createSessionToken,
  isAdmin,
  resetAttempts,
  sessionCookie,
  tooManyAttempts,
  verifySessionToken,
} from '../../lib/auth';
import { isDemoMode } from '../../lib/env';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const client = getClient(slug);
const demo = isDemoMode();

let error: string | null = null;

if (client && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const identifier = `login:${client.slug}:${Astro.clientAddress ?? 'local'}`;

  if (tooManyAttempts(identifier)) {
    error = 'Terlalu banyak percobaan. Coba lagi beberapa menit lagi.';
  } else if (!checkClientPassword(client.slug, password)) {
    error = 'Kata sandi salah. Periksa kembali dari pesan tim Incentric.';
  } else {
    resetAttempts(identifier);
    const token = await createSessionToken([client.slug]);
    Astro.cookies.set(sessionCookie.name, token, cookieOptionsFor(Astro.url));
    return Astro.redirect(`/${client.slug}`);
  }
}

// Sudah punya sesi yang sah? Langsung masuk.
const session = await verifySessionToken(Astro.cookies.get(sessionCookie.name)?.value);
if (client && Astro.request.method === 'GET' && !error) {
  if (isAdmin(session) || session?.scopes.includes(client.slug)) {
    return Astro.redirect(`/${client.slug}`);
  }
}
---

<Base title={`Masuk · ${client?.name ?? 'Dashboard NPS'}`}>
  <main class="flex min-h-screen flex-col bg-brand-night text-white">
    <div class="container-page flex items-center justify-between py-6">
      <a href="/" class="inline-flex items-center gap-2.5">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-yellow text-base font-extrabold text-brand-ink">i</span>
        <span class="text-sm font-extrabold uppercase tracking-[0.22em] text-white">incentric</span>
      </a>
      <a href="/" class="text-xs font-semibold text-white/60 hover:text-white">Dashboard NPS</a>
    </div>

    <div class="flex flex-1 items-center justify-center px-5 pb-16">
      <div class="w-full max-w-md">
        <p class="text-[11px] font-bold uppercase tracking-[0.24em] text-brand-yellow">Area Klien</p>
        <h1 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight text-white md:text-4xl">
          {client ? client.name : 'Dashboard NPS'}
        </h1>
        <p class="mt-3 text-sm leading-relaxed text-white/60">
          {client
            ? 'Masukkan kata sandi yang diberikan tim Incentric untuk melihat hasil survei.'
            : 'Kode klien tidak dikenali. Periksa kembali tautan yang Anda terima.'}
        </p>

        {client ? (
          <form method="POST" class="mt-8 space-y-4">
            <div>
              <label for="password" class="mb-1.5 block text-[11px] font-bold uppercase tracking-[0.14em] text-white/50">
                Kata sandi
              </label>
              <input
                id="password"
                name="password"
                type="password"
                required
                autocomplete="current-password"
                class="h-12 w-full rounded-lg border border-white/15 bg-white/5 px-4 text-sm font-semibold text-white outline-none transition placeholder:font-normal placeholder:text-white/30 focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/20"
                placeholder="••••••••"
              />
            </div>

            {error && (
              <p class="rounded-lg border border-rose-400/30 bg-rose-400/10 p-3 text-xs font-semibold text-rose-200">
                {error}
              </p>
            )}

            <button type="submit" class="h-12 w-full rounded-lg bg-brand-yellow text-sm font-extrabold uppercase tracking-[0.1em] text-brand-ink transition hover:bg-yellow-300">
              Lihat dashboard
            </button>
          </form>
        ) : (
          <a href="/" class="mt-8 inline-flex h-12 items-center rounded-lg bg-brand-yellow px-6 text-sm font-extrabold uppercase tracking-[0.1em] text-brand-ink">
            Kembali
          </a>
        )}

        <p class="mt-8 text-xs leading-relaxed text-white/35">
          Data survei bersifat rahasia dan hanya untuk kepentingan internal klien.
          {demo && ' Mode demo aktif.'}
        </p>
      </div>
    </div>
  </main>
</Base>
