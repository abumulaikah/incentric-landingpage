---
import '../../styles/global.css';
import SiteHeader from '../../components/SiteHeader.astro';

export const prerender = false;

const origin = Astro.url.origin;
const apiBase = `${origin}/api/v1`;

const endpoints = [
  {
    method: 'GET',
    path: '/clients',
    title: 'List clients',
    copy: 'Every client this key can read, with the latest response count and NPS score.',
    params: [],
    response: 'Array of { slug, name, npsScale, responses, nps, lastUpdated }',
  },
  {
    method: 'GET',
    path: '/nps/{slug}',
    title: 'NPS report',
    copy: 'Score, respondent split, stage scores, correlations and — with detail=full — items, distribution, trend and comments.',
    params: [
      ['from', 'ISO date', 'Start of period, e.g. 2026-11-01'],
      ['to', 'ISO date', 'End of period'],
      ['service', 'string', 'Filter by service type (exact match)'],
      ['detail', 'summary | full', 'Default summary. full adds items, distribution, serviceBreakdown, respondentBreakdown, trend and comments'],
    ],
    response: 'Single object (see example below)',
  },
  {
    method: 'GET',
    path: '/nps/{slug}/comments',
    title: 'Verbatim comments',
    copy: 'Patient comments only, newest first. The same records returned inside detail=full.',
    params: [['limit', '1-200', 'Default 50']],
    response: 'Array of { submittedAt, stage, service, respondentType, text }',
  },
  {
    method: 'GET',
    path: '/nps/{slug}/export',
    title: 'CSV export',
    copy: 'Raw Tally-style CSV (one row per submission, one column per question) or the summary report.',
    params: [
      ['from', 'ISO date', 'Optional'],
      ['to', 'ISO date', 'Optional'],
      ['service', 'string', 'Optional'],
      ['format', 'raw | summary', 'Default summary'],
    ],
    response: 'text/csv attachment',
  },
];

const example = `curl "${apiBase}/nps/rsananda?detail=full" \\
  -H "Authorization: Bearer nps_live_<your-key>"`;

const exampleComments = `curl "${apiBase}/nps/rsananda/comments?limit=20" \\
  -H "Authorization: Bearer nps_live_<your-key>"`;

const sampleBody = `{
  "data": {
    "slug": "rsananda",
    "name": "RSU Ananda Srengat",
    "npsScale": "1-5",
    "period": { "from": null, "to": null },
    "filters": { "service": null },
    "totalRespondents": 37,
    "nps": {
      "score": 70.3,
      "promoters": 26,
      "passives": 11,
      "detractors": 0,
      "promoterPct": 70.3,
      "passivePct": 29.7,
      "detractorPct": 0
    },
    "overallMean": 4.62,
    "stages": [
      { "key": "kedatangan", "label": "Kedatangan", "score": 4.71, "responses": 37 },
      { "key": "pemeriksaan", "label": "Pemeriksaan", "score": 4.68, "responses": 37 }
    ],
    "correlations": [
      {
        "key": "pendaftaran",
        "label": "Pendaftaran",
        "score": 4.68,
        "r": 0.418,
        "strength": "Moderate",
        "respondents": 37,
        "recommendation": "Supporting factor of the experience"
      }
    ],
    "updatedAt": "2026-11-05T09:12:00.000Z"
  },
  "meta": { "remainingQuota": 57, "source": "tally" }
}`;

const fullFields = [
  ['items', 'key, label, stageKey, stageLabel, score, responses for every question'],
  ['distribution', 'Response count for every point on the scale'],
  ['serviceBreakdown', 'service, responses, nps, meanScore, promoters, passives, detractors'],
  ['availableServices', 'All service names present in the data (for filters)'],
  ['respondentBreakdown', 'Respondent type counts (patient, companion, ...)'],
  ['trend', 'date, nps, responses per day'],
  ['comments', 'Verbatim text with stage, service, respondentType and submittedAt'],
];

const permissions = [
  ['Read NPS score, promoter split and respondent counts', true],
  ['Read stage scores and per-item scores', true],
  ['Read correlations, strength and recommendations', true],
  ['Read score distribution, daily trend and service breakdown', true],
  ['Read verbatim comments', true],
  ['Download CSV (raw or summary)', true],
  ['Create, edit or delete responses', false],
  ['Change stages, labels or client settings', false],
  ['Read staff names or patient identities', false],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>API Documentation - Incentric NPS</title>
    <meta name="description" content="Read-only REST API for Incentric NPS dashboards." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-brand-surface-soft">
    <SiteHeader
      tone="light"
      clientName="API"
      links={[{ label: 'Admin', href: '/admin' }]}
      action={{ label: 'Dashboard', href: '/' }}
    />

    <main class="container-page max-w-4xl pb-16 pt-24 md:pt-32">
      <p class="kicker">Developers</p>
      <h1 class="display mt-3">NPS API</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600">
        A read-only REST API for client NPS data. Every request needs an API key issued by the
        Incentric team. Partners can read scores, breakdowns, correlations and verbatim comments,
        but can never modify data.
      </p>

      <div class="mt-6 flex flex-wrap gap-2">
        <span class="badge badge-great">Version v1</span>
        <span class="badge badge-muted">Base URL {apiBase}</span>
        <span class="badge badge-muted">60 requests / minute</span>
        <span class="badge badge-muted">Read-only</span>
      </div>

      <!-- Authentication -->
      <section class="card mt-10">
        <p class="card-title">Authentication</p>
        <h2 class="card-heading">Bearer API key</h2>
        <p class="prose-note mt-2">
          Send the key in the <code class="font-mono">Authorization</code> header. Keys look like
          <code class="font-mono">nps_live_</code> followed by 48 hexadecimal characters, and are scoped
          to one client or to all clients.
        </p>
        <pre class="mt-4 overflow-x-auto rounded-lg bg-brand-night p-4 text-[12.5px] leading-relaxed text-slate-100"><code>Authorization: Bearer nps_live_&lt;your-key&gt;</code></pre>
        <p class="prose-note mt-3">
          Keys are shown once when created and stored only as a SHA-256 hash. Revoke a key at any time
          from the admin page; revocation takes effect immediately.
        </p>
      </section>

      <!-- Endpoints -->
      <section class="mt-10 space-y-4">
        <h2 class="text-2xl font-extrabold tracking-tight">Endpoints</h2>
        {endpoints.map((endpoint) => (
          <article class="card">
            <div class="flex flex-wrap items-center gap-2">
              <span class="badge badge-great">{endpoint.method}</span>
              <code class="font-mono text-[13px] font-bold text-slate-800">/api/v1{endpoint.path}</code>
            </div>
            <h3 class="mt-3 text-base font-bold">{endpoint.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{endpoint.copy}</p>
            {endpoint.params.length > 0 && (
              <div class="table-wrap mt-4">
                <table class="data-table !min-w-0">
                  <thead>
                    <tr><th>Query</th><th>Type</th><th>Description</th></tr>
                  </thead>
                  <tbody>
                    {endpoint.params.map((param) => (
                      <tr>
                        <td class="font-mono text-[12px] font-bold">{param[0]}</td>
                        <td class="text-[12px] text-slate-500">{param[1]}</td>
                        <td class="text-[13px] text-slate-600">{param[2]}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            <p class="mt-3 text-[12px] text-slate-500">
              <span class="font-bold uppercase tracking-wider text-slate-400">Returns</span>
              <span class="ml-2">{endpoint.response}</span>
            </p>
          </article>
        ))}
      </section>

      <!-- Response shape -->
      <section class="card mt-10">
        <p class="card-title">Response shape</p>
        <h2 class="card-heading">What detail=full adds</h2>
        <div class="table-wrap mt-4">
          <table class="data-table !min-w-0">
            <thead>
              <tr><th>Field</th><th>Content</th></tr>
            </thead>
            <tbody>
              {fullFields.map((field) => (
                <tr>
                  <td class="font-mono text-[12px] font-bold">{field[0]}</td>
                  <td class="text-[13px] text-slate-600">{field[1]}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="prose-note mt-4">
          All scores are numbers. <code class="font-mono">strength</code> is one of
          <code class="font-mono">Very Strong</code>, <code class="font-mono">Strong</code>,
          <code class="font-mono">Moderate</code>, <code class="font-mono">Weak</code> or
          <code class="font-mono">None</code>, based on the absolute value of <code class="font-mono">r</code>.
        </p>
      </section>

      <!-- Examples -->
      <section class="mt-10">
        <h2 class="text-2xl font-extrabold tracking-tight">Example requests</h2>
        <pre class="mt-4 overflow-x-auto rounded-lg bg-brand-night p-4 text-[12.5px] leading-relaxed text-slate-100"><code>{example}</code></pre>
        <pre class="mt-3 overflow-x-auto rounded-lg bg-brand-night p-4 text-[12.5px] leading-relaxed text-slate-100"><code>{exampleComments}</code></pre>
      </section>

      <section class="mt-10">
        <h2 class="text-2xl font-extrabold tracking-tight">Example response</h2>
        <p class="prose-note mt-2">
          Trimmed to two array entries for readability. Real responses include every stage and every
          correlation.
        </p>
        <pre class="mt-4 overflow-x-auto rounded-lg bg-brand-night p-4 text-[12.5px] leading-relaxed text-slate-100"><code>{sampleBody}</code></pre>
      </section>

      <!-- Permissions -->
      <section class="card mt-10">
        <p class="card-title">Permissions</p>
        <h2 class="card-heading">What partners can and cannot do</h2>
        <div class="table-wrap mt-4">
          <table class="data-table !min-w-0">
            <thead>
              <tr><th>Capability</th><th>Allowed</th></tr>
            </thead>
            <tbody>
              {permissions.map((row) => (
                <tr>
                  <td>{row[0]}</td>
                  <td>
                    {row[1]
                      ? <span class="badge badge-great">Yes</span>
                      : <span class="badge badge-bad">No</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="prose-note mt-4">
          Any request other than <code class="font-mono">GET</code>, <code class="font-mono">HEAD</code>
          or <code class="font-mono">OPTIONS</code> returns <code class="font-mono">405 Method Not Allowed</code>.
        </p>
      </section>

      <!-- Errors -->
      <section class="card mt-10">
        <p class="card-title">Reference</p>
        <h2 class="card-heading">Status codes</h2>
        <div class="table-wrap mt-4">
          <table class="data-table !min-w-0">
            <thead>
              <tr><th>Code</th><th>Meaning</th></tr>
            </thead>
            <tbody>
              <tr><td class="font-mono font-bold">200</td><td>Success</td></tr>
              <tr><td class="font-mono font-bold">401</td><td>Missing or invalid API key</td></tr>
              <tr><td class="font-mono font-bold">403</td><td>Key is not scoped to this client</td></tr>
              <tr><td class="font-mono font-bold">404</td><td>Unknown client slug</td></tr>
              <tr><td class="font-mono font-bold">405</td><td>Method not allowed (API is read-only)</td></tr>
              <tr><td class="font-mono font-bold">429</td><td>Rate limit exceeded (60 per minute)</td></tr>
              <tr><td class="font-mono font-bold">500 / 502</td><td>Upstream failure (Tally API or export)</td></tr>
            </tbody>
          </table>
        </div>
        <p class="prose-note mt-4">
          Errors use the shape <code class="font-mono">{'{ "error": { "code": "...", "message": "..." } }'}</code>.
          Successful responses include the header <code class="font-mono">x-ratelimit-remaining</code>.
        </p>
      </section>

      <!-- Notes -->
      <section class="card mt-6">
        <p class="card-title">Notes</p>
        <h2 class="card-heading">Caching and data scope</h2>
        <ul class="mt-3 space-y-2 text-sm leading-relaxed text-slate-600">
          <li>Data is cached for 5 minutes, so <code class="font-mono">updatedAt</code> may lag behind Tally slightly.</li>
          <li>Only completed submissions are counted. Partial submissions are ignored.</li>
          <li>Scores use the client scale: <code class="font-mono">1-5</code> or <code class="font-mono">0-10</code>.</li>
          <li>Correlations are computed per respondent and are indicative for small samples.</li>
          <li>Keys scoped to a single client return <code class="font-mono">403</code> for every other slug.</li>
        </ul>
      </section>

      <section class="card mt-6">
        <p class="card-title">Access</p>
        <h2 class="card-heading">Requesting a key</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          API keys are issued by Incentric only. Contact the team with the name of your application
          and the client you need to read. Keys are read-only and cannot modify data.
        </p>
        <a href="/admin" class="btn btn-primary mt-5">Admin</a>
      </section>

      <p class="prose-note mt-10 pb-6">
        Data is confidential and intended for the client and their approved partners only.
        Do not cache or publish respondent-level data without written permission.
      </p>
    </main>
  </body>
</html>
