---
import '../../styles/global.css';

export const prerender = false;

const origin = Astro.url.origin;
const base = `${origin}/api/v1`;

const endpoints = [
  {
    method: 'GET',
    path: '/clients',
    title: 'List clients',
    copy: 'All client dashboards this key can read, with response count and current NPS.',
    params: [],
  },
  {
    method: 'GET',
    path: '/nps/{slug}',
    title: 'NPS summary',
    copy: 'Score, promoter split, stage scores and correlations for one client.',
    params: [
      ['from', 'ISO date', 'Start of period, e.g. 2026-01-01'],
      ['to', 'ISO date', 'End of period'],
      ['service', 'string', 'Filter by service type'],
      ['detail', 'summary | full', 'full adds items, distribution, trend and comments'],
    ],
  },
  {
    method: 'GET',
    path: '/nps/{slug}/comments',
    title: 'Comments',
    copy: 'Patient comments only, newest first.',
    params: [['limit', '1-200', 'Default 50']],
  },
  {
    method: 'GET',
    path: '/nps/{slug}/export',
    title: 'CSV export',
    copy: 'The same CSV produced by the dashboard export button.',
    params: [
      ['from', 'ISO date', 'Optional'],
      ['to', 'ISO date', 'Optional'],
      ['service', 'string', 'Optional'],
    ],
  },
];

const example = `curl "${base}/nps/rsananda?detail=summary" \\
  -H "Authorization: Bearer nps_live_xxxxxxxxxxxxxxxx"`;

const sampleBody = `{
  "data": {
    "slug": "rsananda",
    "name": "RSU Ananda Srengat",
    "npsScale": "1-5",
    "period": { "from": null, "to": null },
    "totalRespondents": 29,
    "nps": {
      "score": 72.4,
      "promoters": 21,
      "passives": 8,
      "detractors": 0,
      "promoterPct": 72.4,
      "passivePct": 27.6,
      "detractorPct": 0
    },
    "overallMean": 4.62,
    "stages": [
      { "key": "kedatangan", "label": "Kedatangan", "score": 4.71, "responses": 29 }
    ],
    "correlations": [
      {
        "key": "pendaftaran",
        "label": "Pendaftaran",
        "score": 4.68,
        "r": 0.418,
        "strength": "Moderate",
        "respondents": 29,
        "recommendation": "Supporting factor of the experience"
      }
    ],
    "updatedAt": "2026-11-05T09:12:00.000Z"
  },
  "meta": { "remainingQuota": 57, "source": "tally" }
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>API Documentation - Incentric NPS</title>
    <meta name="description" content="Read-only REST API for Incentric NPS dashboards." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-brand-surface-soft">
    <header class="border-b border-slate-300 bg-white">
      <div class="container-page flex flex-wrap items-center justify-between gap-3 py-4">
        <a href="/" class="flex items-center gap-3">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-ink text-base font-extrabold text-brand-yellow">i</span>
          <span class="text-sm font-extrabold uppercase tracking-[0.24em]">incentric</span>
        </a>
        <div class="flex items-center gap-2">
          <a href="/admin" class="btn btn-outline !min-h-10 !px-4">Admin</a>
          <a href="/" class="btn btn-dark !min-h-10 !px-4">Dashboard</a>
        </div>
      </div>
    </header>

    <main class="container-page max-w-4xl py-12">
      <p class="kicker">Developers</p>
      <h1 class="display mt-3">NPS API</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600">
        A read-only REST API for client NPS data. Every request needs an API key issued by the
        Incentric team. Responses are JSON, except the CSV export endpoint.
      </p>

      <div class="mt-6 flex flex-wrap gap-2">
        <span class="badge badge-great">Version v1</span>
        <span class="badge badge-muted">Base URL {base}</span>
        <span class="badge badge-muted">60 requests / minute</span>
      </div>

      <!-- Authentication -->
      <section class="card mt-10">
        <p class="card-title">Authentication</p>
        <h2 class="card-heading">Bearer API key</h2>
        <p class="prose-note mt-2">
          Send the key in the <code class="font-mono">Authorization</code> header. Keys start with
          <code class="font-mono">nps_live_</code> and are scoped to one client or to all clients.
        </p>
        <pre class="mt-4 overflow-x-auto rounded-lg bg-brand-night p-4 text-[12.5px] leading-relaxed text-slate-100"><code>Authorization: Bearer nps_live_xxxxxxxxxxxxxxxx</code></pre>
        <p class="prose-note mt-3">
          Keys are shown once when created and stored only as a hash. Revoke a key any time from the admin page.
        </p>
      </section>

      <!-- Endpoints -->
      <section class="mt-10 space-y-4">
        <h2 class="text-2xl font-extrabold tracking-tight">Endpoints</h2>
        {endpoints.map((endpoint) => (
          <article class="card">
            <div class="flex flex-wrap items-center gap-2">
              <span class="badge badge-great">{endpoint.method}</span>
              <code class="font-mono text-[13px] font-bold text-slate-800">/api/v1{endpoint.path}</code>
            </div>
            <h3 class="mt-3 text-base font-bold">{endpoint.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{endpoint.copy}</p>
            {endpoint.params.length > 0 && (
              <div class="table-wrap mt-4">
                <table class="data-table !min-w-0">
                  <thead>
                    <tr><th>Query</th><th>Type</th><th>Description</th></tr>
                  </thead>
                  <tbody>
                    {endpoint.params.map((param) => (
                      <tr>
                        <td class="font-mono text-[12px] font-bold">{param[0]}</td>
                        <td class="text-[12px] text-slate-500">{param[1]}</td>
                        <td class="text-[13px] text-slate-600">{param[2]}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </article>
        ))}
      </section>

      <!-- Examples -->
      <section class="mt-10">
        <h2 class="text-2xl font-extrabold tracking-tight">Example request</h2>
        <pre class="mt-4 overflow-x-auto rounded-lg bg-brand-night p-4 text-[12.5px] leading-relaxed text-slate-100"><code>{example}</code></pre>
      </section>

      <section class="mt-10">
        <h2 class="text-2xl font-extrabold tracking-tight">Example response</h2>
        <pre class="mt-4 overflow-x-auto rounded-lg bg-brand-night p-4 text-[12.5px] leading-relaxed text-slate-100"><code>{sampleBody}</code></pre>
      </section>

      <!-- Errors -->
      <section class="card mt-10">
        <p class="card-title">Reference</p>
        <h2 class="card-heading">Status codes</h2>
        <div class="table-wrap mt-4">
          <table class="data-table !min-w-0">
            <thead>
              <tr><th>Code</th><th>Meaning</th></tr>
            </thead>
            <tbody>
              <tr><td class="font-mono font-bold">200</td><td>Success</td></tr>
              <tr><td class="font-mono font-bold">401</td><td>Missing or invalid API key</td></tr>
              <tr><td class="font-mono font-bold">403</td><td>Key is not scoped to this client</td></tr>
              <tr><td class="font-mono font-bold">404</td><td>Unknown client slug</td></tr>
              <tr><td class="font-mono font-bold">429</td><td>Rate limit exceeded (60 per minute)</td></tr>
            </tbody>
          </table>
        </div>
        <p class="prose-note mt-4">
          Errors return <code class="font-mono">{'{ "error": { "code": "...", "message": "..." } }'}</code>.
          Data is cached for 5 minutes, so <code class="font-mono">updatedAt</code> may lag behind Tally slightly.
        </p>
      </section>

      <section class="card mt-6">
        <p class="card-title">Access</p>
        <h2 class="card-heading">Requesting a key</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          API keys are issued by Incentric only. Contact the team with the name of your application
          and the client you need to read. Keys are read-only and cannot modify data.
        </p>
        <a href="/admin" class="btn btn-primary mt-5">Admin</a>
      </section>

      <p class="prose-note mt-10 pb-6">
        Data is confidential and intended for the client and their approved partners only.
        Do not cache or publish respondent-level data without written permission.
      </p>
    </main>
  </body>
</html>
