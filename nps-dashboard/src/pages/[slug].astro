---
import Base from '../layouts/Base.astro';
import BarChart from '../components/BarChart.astro';
import DistributionChart from '../components/DistributionChart.astro';
import DonutChart from '../components/DonutChart.astro';
import NpsGauge from '../components/NpsGauge.astro';
import ItemScoreChart from '../components/ItemScoreChart.astro';
import TrendChart from '../components/TrendChart.astro';
import { isAdmin, verifySessionToken, sessionCookie } from '../lib/auth';
import { COLORS } from '../lib/colors';
import { getClient, STAGES } from '../lib/config';
import { loadDashboard } from '../lib/data';
import {
  formatDate,
  formatNumber,
  formatPercent,
  formatScore,
  strengthTone,
} from '../lib/format';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const client = getClient(slug);

if (!client) {
  return Astro.redirect('/');
}

const session = await verifySessionToken(Astro.cookies.get(sessionCookie.name)?.value);
const authorized = isAdmin(session) || session?.scopes.includes(client.slug);

if (!authorized) {
  return Astro.redirect(`/login/${client.slug}`);
}

const url = Astro.url;
const filters = {
  from: url.searchParams.get('from') || null,
  to: url.searchParams.get('to') || null,
  service: url.searchParams.get('service') || null,
};

const result = await loadDashboard(client.slug, filters);
const data = result?.data;
const demo = data?.meta.source === 'fixture';

const nps = data?.nps ?? null;
const donutSlices = [
  { label: 'Promoter', value: nps?.promoterPct ?? 0, count: nps?.promoters ?? 0, color: COLORS.promoter },
  { label: 'Passive', value: nps?.passivePct ?? 0, count: nps?.passives ?? 0, color: COLORS.passive },
  { label: 'Detractor', value: nps?.detractorPct ?? 0, count: nps?.detractors ?? 0, color: COLORS.detractor },
];

const stageBars = (data?.stages ?? []).map((stage) => ({
  label: stage.label,
  value: stage.score,
  note: `${stage.responses} responden`,
  highlight: stage.score !== null && stage.score === Math.max(...(data?.stages ?? []).map((item) => item.score ?? 0)),
}));

const scoreMax = data?.meta.npsScale === '1-5' ? 5 : 10;
const hasData = Boolean(nps && nps.total > 0);

// Rentang tanggal efektif: filter bila ada, jika tidak pakai rentang data.
const trendDates = (data?.dailyTrend ?? []).map((point) => point.date).filter((date) => date !== 'unknown').sort();
const rangeFrom = filters.from ?? trendDates[0] ?? null;
const rangeTo = filters.to ?? trendDates[trendDates.length - 1] ?? null;

const lowestStage = [...(data?.stages ?? [])]
  .filter((stage) => stage.score !== null && !stage.optional)
  .sort((a, b) => (a.score ?? 0) - (b.score ?? 0))[0];
---

<Base title={`Dashboard NPS · ${client.name}`}>
  <div class="shell">
    <!-- Top bar -->
    <header class="no-print border-b border-slate-200 bg-white">
      <div class="container-page flex flex-wrap items-center justify-between gap-4 py-4">
        <div class="flex items-center gap-4">
          <a href="/" class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-ink text-base font-extrabold text-brand-yellow">i</a>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-slate-400">Dashboard NPS</p>
            <p class="text-sm font-extrabold leading-tight">{client.name}</p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          {demo && (
            <span class="badge badge-warn">Mode demo</span>
          )}
          {session && isAdmin(session) && (
            <a href="/admin" class="btn btn-outline !min-h-10 !px-4">Admin</a>
          )}
          <a
            href={`/api/export?slug=${client.slug}${filters.from ? `&from=${filters.from}` : ''}${filters.to ? `&to=${filters.to}` : ''}${filters.service ? `&service=${encodeURIComponent(filters.service)}` : ''}`}
            class="btn btn-dark !min-h-10 !px-4"
          >
            Export CSV
          </a>
          <form method="POST" action="/api/logout" class="inline">
            <button type="submit" class="btn btn-outline !min-h-10 !px-4">Keluar</button>
          </form>
        </div>
      </div>
    </header>

    <main class="container-page space-y-5 py-6 md:space-y-6 md:py-8">
      <!-- Title + filter -->
      <div class="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
        <div>
          <h1 class="text-2xl font-extrabold tracking-tight md:text-[2rem]">Patient Experience Report</h1>
          <p class="mt-1.5 text-sm text-slate-500">
            {formatDate(rangeFrom)} – {formatDate(rangeTo)}
            {data?.filters.service ? ` · ${data.filters.service}` : ' · All services'}
            {data?.meta.generatedAt ? ` · updated ${new Date(data.meta.generatedAt).toLocaleString('en-GB')}` : ''}
          </p>
        </div>

        <form method="GET" class="no-print flex w-full flex-wrap items-end gap-2 xl:w-auto">
          <label class="flex min-w-0 flex-1 basis-[140px] flex-col gap-1 sm:flex-none sm:basis-auto">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">From</span>
            <input type="date" name="from" value={filters.from ?? ''} class="field !w-full !min-w-0 sm:!w-[150px]" />
          </label>
          <label class="flex min-w-0 flex-1 basis-[140px] flex-col gap-1 sm:flex-none sm:basis-auto">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">To</span>
            <input type="date" name="to" value={filters.to ?? ''} class="field !w-full !min-w-0 sm:!w-[150px]" />
          </label>
          <label class="flex min-w-0 flex-1 basis-[160px] flex-col gap-1 sm:flex-none sm:basis-auto">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Service</span>
            <select name="service" class="field !w-full !min-w-0 sm:!w-[180px]">
              <option value="">All services</option>
              {(data?.availableServices ?? []).map((service) => (
                <option value={service} selected={service === filters.service}>{service}</option>
              ))}
            </select>
          </label>
          <button type="submit" class="btn btn-primary !min-h-11 shrink-0 whitespace-nowrap">Apply</button>
          {(filters.from || filters.to || filters.service) && (
            <a href={`/${client.slug}`} class="btn btn-outline !min-h-11 shrink-0">Reset</a>
          )}
        </form>
      </div>

      {data?.meta.warning && (
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-relaxed text-amber-900">
          <strong class="font-extrabold">Catatan data.</strong> {data.meta.warning}
        </div>
      )}

      {!hasData ? (
        <div class="card text-center">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-brand-blue">No data yet</p>
          <h2 class="mt-3 text-2xl font-extrabold">No responses to display</h2>
          <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-slate-500">
            The dashboard fills automatically once completed submissions arrive in Tally.
            If this persists, check the API key and Form ID in the Vercel environment.
          </p>
        </div>
      ) : (
        <>
          <!-- KPI -->
          <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            <div class="card">
              <p class="stat-label">Total Respondents</p>
              <p class="stat-value tabular-nums">{formatNumber(nps?.total)}</p>
              <p class="stat-note">
                {demo ? 'Demo data' : `${formatNumber(data?.meta.totalSubmissions)} completed submissions`}
                {data && data.meta.excludedNoNps > 0 ? ` · ${data.meta.excludedNoNps} without an NPS score` : ''}
              </p>
            </div>

            <div class="card">
              <p class="stat-label">Net Promoter Score</p>
              <div class="mt-3">
                <NpsGauge
                  score={nps?.score ?? null}
                  metaScore={data?.overallMean ?? null}
                  metaLabel="Average satisfaction score"
                />
              </div>
            </div>

            <div class="card">
              <p class="stat-label">Promoter Share</p>
              <p class="stat-value tabular-nums">
                {formatPercent(nps?.promoterPct)}
              </p>
              <p class="stat-note">
                {formatNumber(nps?.promoters)} of {formatNumber(nps?.total)} respondents would recommend
              </p>
              <div class="mt-4 flex gap-1.5">
                {[
                  { label: 'P', value: nps?.promoterPct ?? 0, color: COLORS.promoter },
                  { label: 'Pa', value: nps?.passivePct ?? 0, color: COLORS.passive },
                  { label: 'D', value: nps?.detractorPct ?? 0, color: COLORS.detractor },
                ].map((item) => (
                  <div class="flex-1">
                    <div class="h-1.5 rounded-full" style={`width:100%;background:${item.color};opacity:${item.value > 0 ? 0.9 : 0.15}`}></div>
                    <p class="mt-1 text-[10px] font-bold text-slate-400">{item.label}</p>
                  </div>
                ))}
              </div>
            </div>

            <div class="card">
              <p class="stat-label">Overall Satisfaction</p>
              <p class="stat-value tabular-nums">
                {formatScore(data?.overallMean)}
                <span class="text-base font-bold text-slate-400"> / {scoreMax}</span>
              </p>
              <p class="stat-note">
                {formatNumber(data?.overallMeanCount)} scale answers · all service stages
              </p>
              <p class="mt-4 text-xs font-semibold text-slate-500">
                Lowest stage:{' '}
                <span class="font-extrabold text-slate-800">
                  {lowestStage?.shortLabel ?? '–'}
                </span>
              </p>
            </div>
          </section>

          <!-- Donut + distribution -->
          <section class="grid gap-4 lg:grid-cols-[0.85fr_1.15fr]">
            <div class="card">
              <p class="card-title">Loyalty Split</p>
              <h2 class="card-heading">NPS Category Distribution</h2>
              <div class="mt-6">
                <DonutChart
                  slices={donutSlices}
                  total={nps?.total ?? 0}
                  centerValue={`${formatNumber(nps?.total)}`}
                  centerLabel="responden"
                />
              </div>
            </div>

            <div class="card">
              <p class="card-title">Response Distribution</p>
              <h2 class="card-heading">Recommendation Score Spread</h2>
              <div class="mt-6">
                <DistributionChart points={data?.distribution ?? []} scale={data?.meta.npsScale ?? '1-5'} />
              </div>
            </div>
          </section>

          <!-- Detail butir (satu baris penuh) -->
          <section class="card">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <p class="card-title">Item-Level Scores</p>
                <h2 class="card-heading">Experience Trend Across Questions</h2>
                <p class="prose-note mt-2 max-w-2xl">
                  Questions follow the patient journey, from arrival to general facilities.
                </p>
              </div>
              <span class="badge badge-muted shrink-0">{formatNumber(data?.items.length)} items</span>
            </div>
            <div class="mt-7">
              <ItemScoreChart
                items={data?.items ?? []}
                stages={STAGES.map((stage) => ({ key: stage.key, shortLabel: stage.shortLabel }))}
                max={scoreMax}
              />
            </div>
          </section>

          <!-- Evaluasi per tahap (baris di bawahnya) -->
          <section class="card">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <p class="card-title">Stage Scores</p>
                <h2 class="card-heading">Average Satisfaction by Service Stage</h2>
              </div>
              <span class="badge badge-muted shrink-0">Scale 1–{scoreMax}</span>
            </div>
            <div class="mt-6">
              <BarChart
                bars={stageBars}
                min={data?.meta.npsScale === '1-5' ? 1 : 0}
                max={scoreMax}
                color={COLORS.accent}
                emptyMessage="No stage scores yet."
              />
            </div>
            <p class="prose-note mt-6">
              Averages are computed from the questions that make up each stage. The inpatient room
              stage only appears when admitted patients answer it.
            </p>
          </section>

          <!-- Correlation -->
          <section class="card">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <p class="card-title">Correlation Analysis</p>
                <h2 class="card-heading">Stage Satisfaction vs. Loyalty (NPS)</h2>
                <p class="prose-note mt-2 max-w-3xl">
                  Pearson correlation (r) between each stage score and the recommendation score per respondent.
                  Values closer to 1 indicate the stage that most drives patient loyalty.
                </p>
              </div>
              <span class="badge badge-muted shrink-0">Pearson r</span>
            </div>

            <div class="table-wrap mt-6">
              <table class="data-table">
                <thead>
                  <tr>
                    <th class="w-10">#</th>
                    <th>Service Stage</th>
                    <th class="text-right">Score</th>
                    <th class="w-[32%]">Correlation Strength (r)</th>
                    <th>Status &amp; Recommended Action</th>
                    <th class="text-right">Respondents</th>
                  </tr>
                </thead>
                <tbody>
                  {(data?.correlations ?? []).map((row) => (
                    <tr>
                      <td class="font-extrabold text-slate-400 tabular-nums">{row.rank}</td>
                      <td class="font-bold">{row.label}</td>
                      <td class="text-right font-semibold tabular-nums">{formatScore(row.score)}</td>
                      <td>
                        <div class="flex items-center gap-2.5">
                          <div class="h-2 w-full min-w-[90px] overflow-hidden rounded-full bg-slate-100">
                            <div
                              class="h-full rounded-full"
                              style={`width:${row.r === null ? 0 : Math.max(2, Math.min(100, Math.abs(row.r) * 100))}%;background:${COLORS.primary};opacity:${row.rank === 1 ? 1 : 0.7}`}
                            ></div>
                          </div>
                          <span class="w-11 shrink-0 text-right text-[13px] font-extrabold tabular-nums">
                            {row.r === null ? '–' : row.r.toFixed(3)}
                          </span>
                          <span class={`badge badge-${strengthTone(row.strength)} shrink-0`}>{row.strength}</span>
                        </div>
                      </td>
                      <td class="text-slate-600">{row.recommendation}</td>
                      <td class="text-right text-slate-500 tabular-nums">{row.n}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {(data?.correlations[0]?.r ?? 0) >= 0.5 ? (
              <div class="mt-6 rounded-lg border border-brand-blue/20 bg-brand-blue/[0.04] p-4 text-sm leading-relaxed text-slate-700">
                <strong class="font-extrabold text-brand-ink">Key finding.</strong>{' '}
                {data?.correlations[0]?.label} shows the strongest correlation (r = {data?.correlations[0]?.r?.toFixed(3)}) with patient loyalty.
                Improvements in this stage are likely to have the greatest impact on NPS.
              </div>
            ) : (
              <div class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm leading-relaxed text-slate-600">
                <strong class="font-extrabold text-brand-ink">Note.</strong> No stage shows a strong correlation yet.
                Increase the number of respondents so the relationship is more stable before using it to set priorities.
              </div>
            )}
          </section>

          <!-- Trend + breakdown -->
          <section class="grid gap-4 lg:grid-cols-[1.15fr_0.85fr]">
            <div class="card">
              <p class="card-title">Trend</p>
              <h2 class="card-heading">Daily NPS</h2>
              {(data?.dailyTrend.length ?? 0) > 1 ? (
                <div class="mt-5">
                  <TrendChart points={data?.dailyTrend ?? []} />
                </div>
              ) : (
                <div class="mt-5 flex h-[180px] flex-col items-center justify-center rounded-lg border border-dashed border-slate-200 bg-slate-50 text-center">
                  <p class="text-sm font-bold text-slate-600">Only one day of data available</p>
                  <p class="mt-1 max-w-xs text-xs leading-relaxed text-slate-500">
                    The trend chart appears automatically once the survey has run for more than one day.
                  </p>
                </div>
              )}
            </div>

            <div class="card">
              <p class="card-title">Segmentation</p>
              <h2 class="card-heading">By Service Type</h2>
              <div class="mt-4 space-y-3">
                {(data?.serviceBreakdown ?? []).map((item) => {
                  const pct = nps && nps.total > 0 ? (item.count / nps.total) * 100 : 0;
                  return (
                    <div>
                      <div class="flex items-baseline justify-between gap-3">
                        <span class="text-[13px] font-semibold text-slate-700">{item.label}</span>
                        <span class="shrink-0 text-xs font-bold text-slate-500 tabular-nums">
                          {item.count} respondents
                        </span>
                      </div>
                      <div class="mt-1 flex items-center gap-2">
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-slate-100">
                          <div class="h-full rounded-full bg-brand-blue/70" style={`width:${pct}%`}></div>
                        </div>
                        <span class="w-16 shrink-0 text-right text-[11px] font-bold tabular-nums" title="Skor NPS segmen">
                          NPS {item.nps === null ? '–' : `${item.nps > 0 ? '+' : ''}${item.nps}`}
                        </span>
                      </div>
                    </div>
                  );
                })}
              </div>

              <div class="mt-6 border-t border-slate-100 pt-4">
                <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">Respondent Type</p>
                <div class="mt-2 flex flex-wrap gap-2">
                  {(data?.respondentBreakdown ?? []).map((item) => (
                    <span class="badge badge-muted">{item.label} · {item.count}</span>
                  ))}
                </div>
              </div>
            </div>
          </section>

          <!-- Comments -->
          <section class="card">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <p class="card-title">Voice of Customer</p>
                <h2 class="card-heading">Comments &amp; Feedback</h2>
              </div>
              <span class="badge badge-muted shrink-0">{formatNumber(data?.comments.length)} comments</span>
            </div>

            {(data?.comments.length ?? 0) === 0 ? (
              <p class="mt-6 text-sm text-slate-500">No comments submitted yet.</p>
            ) : (
              <div class="mt-5 grid gap-3 md:grid-cols-2">
                {(data?.comments ?? []).slice(0, 40).map((comment) => (
                  <article class="rounded-lg border border-slate-200 bg-slate-50/60 p-4">
                    <div class="flex flex-wrap items-center gap-1.5">
                      <span class="badge badge-good">{comment.stageLabel}</span>
                      {comment.serviceType && <span class="badge badge-muted">{comment.serviceType}</span>}
                      <span class="ml-auto text-[11px] font-medium text-slate-400">{formatDate(comment.submittedAt)}</span>
                    </div>
                    <p class="mt-2.5 text-sm leading-relaxed text-slate-700">{comment.text}</p>
                  </article>
                ))}
              </div>
            )}
          </section>

          <p class="prose-note pb-4">
            This report is generated automatically by the Incentric CX Dashboard. NPS is calculated from the recommendation question
            {data?.meta.npsScale === '1-5' ? ' on a 1–5 scale (5 = promoter, 4 = passive, 1–3 = detractor)' : ' on a 0–10 scale'}.
            Correlations are computed at respondent level and are indicative only for small samples.
          </p>
        </>
      )}
    </main>
  </div>
</Base>
