---
import Base from '../layouts/Base.astro';
import BarChart from '../components/BarChart.astro';
import DistributionChart from '../components/DistributionChart.astro';
import DonutChart from '../components/DonutChart.astro';
import NpsGauge from '../components/NpsGauge.astro';
import TrendChart from '../components/TrendChart.astro';
import { isAdmin, verifySessionToken, sessionCookie } from '../lib/auth';
import { COLORS } from '../lib/colors';
import { getClient } from '../lib/config';
import { loadDashboard } from '../lib/data';
import {
  formatDate,
  formatNumber,
  formatPercent,
  formatScore,
  strengthTone,
} from '../lib/format';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const client = getClient(slug);

if (!client) {
  return Astro.redirect('/');
}

const session = await verifySessionToken(Astro.cookies.get(sessionCookie.name)?.value);
const authorized = isAdmin(session) || session?.scopes.includes(client.slug);

if (!authorized) {
  return Astro.redirect(`/login/${client.slug}`);
}

const url = Astro.url;
const filters = {
  from: url.searchParams.get('from') || null,
  to: url.searchParams.get('to') || null,
  service: url.searchParams.get('service') || null,
};

const result = await loadDashboard(client.slug, filters);
const data = result?.data;
const demo = data?.meta.source === 'fixture';

const nps = data?.nps ?? null;
const donutSlices = [
  { label: 'Promoter', value: nps?.promoterPct ?? 0, count: nps?.promoters ?? 0, color: COLORS.promoter },
  { label: 'Passive', value: nps?.passivePct ?? 0, count: nps?.passives ?? 0, color: COLORS.passive },
  { label: 'Detractor', value: nps?.detractorPct ?? 0, count: nps?.detractors ?? 0, color: COLORS.detractor },
];

const stageBars = (data?.stages ?? []).map((stage) => ({
  label: stage.label,
  value: stage.score,
  note: `${stage.responses} responden menjawab`,
  highlight: stage.score !== null && stage.score === Math.max(...(data?.stages ?? []).map((item) => item.score ?? 0)),
}));

const correlationBars = (data?.correlations ?? []).map((item) => ({
  label: item.shortLabel,
  value: item.r,
  highlight: item.rank === 1,
}));

const scoreMax = data?.meta.npsScale === '1-5' ? 5 : 10;
const hasData = Boolean(nps && nps.total > 0);

// Rentang tanggal efektif: filter bila ada, jika tidak pakai rentang data.
const trendDates = (data?.dailyTrend ?? []).map((point) => point.date).filter((date) => date !== 'unknown').sort();
const rangeFrom = filters.from ?? trendDates[0] ?? null;
const rangeTo = filters.to ?? trendDates[trendDates.length - 1] ?? null;
---

<Base title={`Dashboard NPS · ${client.name}`}>
  <div class="shell">
    <!-- Top bar -->
    <header class="no-print border-b border-slate-200 bg-white">
      <div class="container-page flex flex-wrap items-center justify-between gap-4 py-4">
        <div class="flex items-center gap-4">
          <a href="/" class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-ink text-base font-extrabold text-brand-yellow">i</a>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-slate-400">Dashboard NPS</p>
            <p class="text-sm font-extrabold leading-tight">{client.name}</p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          {demo && (
            <span class="badge badge-warn">Mode demo</span>
          )}
          {session && isAdmin(session) && (
            <a href="/admin" class="btn btn-outline !min-h-10 !px-4">Admin</a>
          )}
          <a
            href={`/api/export?slug=${client.slug}${filters.from ? `&from=${filters.from}` : ''}${filters.to ? `&to=${filters.to}` : ''}${filters.service ? `&service=${encodeURIComponent(filters.service)}` : ''}`}
            class="btn btn-dark !min-h-10 !px-4"
          >
            Export CSV
          </a>
          <form method="POST" action="/api/logout" class="inline">
            <button type="submit" class="btn btn-outline !min-h-10 !px-4">Keluar</button>
          </form>
        </div>
      </div>
    </header>

    <main class="container-page space-y-5 py-6 md:space-y-6 md:py-8">
      <!-- Title + filter -->
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h1 class="text-2xl font-extrabold tracking-tight md:text-[2rem]">Laporan Pengalaman Pasien</h1>
          <p class="mt-1.5 text-sm text-slate-500">
            {formatDate(rangeFrom)} – {formatDate(rangeTo)}
            {data?.filters.service ? ` · ${data.filters.service}` : ' · Semua layanan'}
            {data?.meta.generatedAt ? ` · diperbarui ${new Date(data.meta.generatedAt).toLocaleString('id-ID')}` : ''}
          </p>
        </div>

        <form method="GET" class="no-print flex flex-wrap items-end gap-2">
          <label class="flex flex-col gap-1">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Dari</span>
            <input type="date" name="from" value={filters.from ?? ''} class="field !w-auto !min-w-[150px]" />
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Sampai</span>
            <input type="date" name="to" value={filters.to ?? ''} class="field !w-auto !min-w-[150px]" />
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Layanan</span>
            <select name="service" class="field !w-auto !min-w-[180px]">
              <option value="">Semua layanan</option>
              {(data?.availableServices ?? []).map((service) => (
                <option value={service} selected={service === filters.service}>{service}</option>
              ))}
            </select>
          </label>
          <button type="submit" class="btn btn-primary !min-h-11">Terapkan</button>
          {(filters.from || filters.to || filters.service) && (
            <a href={`/${client.slug}`} class="btn btn-outline !min-h-11">Reset</a>
          )}
        </form>
      </div>

      {data?.meta.warning && (
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-relaxed text-amber-900">
          <strong class="font-extrabold">Catatan data.</strong> {data.meta.warning}
        </div>
      )}

      {!hasData ? (
        <div class="card text-center">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-brand-blue">Belum ada data</p>
          <h2 class="mt-3 text-2xl font-extrabold">Belum ada respons yang bisa ditampilkan</h2>
          <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-slate-500">
            Dashboard akan terisi otomatis setelah ada submission selesai di form Tally.
            Jika ini terjadi terus, periksa API key dan Form ID di environment Vercel.
          </p>
        </div>
      ) : (
        <>
          <!-- KPI -->
          <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            <div class="card">
              <p class="stat-label">Total responden</p>
              <p class="stat-value tabular-nums">{formatNumber(nps?.total)}</p>
              <p class="stat-note">
                {demo ? 'Data demo' : `${formatNumber(data?.meta.totalSubmissions)} submission selesai`}
                {data && data.meta.excludedNoNps > 0 ? ` · ${data.meta.excludedNoNps} tanpa skor NPS` : ''}
              </p>
            </div>

            <div class="card">
              <p class="stat-label">Net Promoter Score</p>
              <div class="mt-3">
                <NpsGauge
                  score={nps?.score ?? null}
                  metaScore={data?.overallMean ?? null}
                  metaLabel="Rata-rata skor kepuasan"
                />
              </div>
            </div>

            <div class="card">
              <p class="stat-label">Persentase promoter</p>
              <p class="stat-value tabular-nums">
                {formatPercent(nps?.promoterPct)}
              </p>
              <p class="stat-note">
                {formatNumber(nps?.promoters)} dari {formatNumber(nps?.total)} pasien merekomendasikan
              </p>
              <div class="mt-4 flex gap-1.5">
                {[
                  { label: 'P', value: nps?.promoterPct ?? 0, color: COLORS.promoter },
                  { label: 'Pa', value: nps?.passivePct ?? 0, color: COLORS.passive },
                  { label: 'D', value: nps?.detractorPct ?? 0, color: COLORS.detractor },
                ].map((item) => (
                  <div class="flex-1">
                    <div class="h-1.5 rounded-full" style={`width:100%;background:${item.color};opacity:${item.value > 0 ? 0.9 : 0.15}`}></div>
                    <p class="mt-1 text-[10px] font-bold text-slate-400">{item.label}</p>
                  </div>
                ))}
              </div>
            </div>

            <div class="card">
              <p class="stat-label">Rata-rata kepuasan</p>
              <p class="stat-value tabular-nums">
                {formatScore(data?.overallMean)}
                <span class="text-base font-bold text-slate-400"> / {scoreMax}</span>
              </p>
              <p class="stat-note">
                {formatNumber(data?.overallMeanCount)} jawaban skala · seluruh tahap layanan
              </p>
              <p class="mt-4 text-xs font-semibold text-slate-500">
                Skor terendah:{' '}
                <span class="font-extrabold text-slate-800">
                  {[...(data?.stages ?? [])].filter((stage) => stage.score !== null).sort((a, b) => (a.score ?? 0) - (b.score ?? 0))[0]?.shortLabel ?? '–'}
                </span>
              </p>
            </div>
          </section>

          <!-- Donut + distribution -->
          <section class="grid gap-4 lg:grid-cols-[0.85fr_1.15fr]">
            <div class="card">
              <p class="card-title">Proporsi loyalitas pasien</p>
              <h2 class="card-heading">Kategori NPS</h2>
              <div class="mt-6">
                <DonutChart
                  slices={donutSlices}
                  total={nps?.total ?? 0}
                  centerValue={`${formatNumber(nps?.total)}`}
                  centerLabel="responden"
                />
              </div>
            </div>

            <div class="card">
              <p class="card-title">Distribusi jawaban</p>
              <h2 class="card-heading">Sebaran skor rekomendasi</h2>
              <div class="mt-6">
                <DistributionChart points={data?.distribution ?? []} scale={data?.meta.npsScale ?? '1-5'} />
              </div>
            </div>
          </section>

          <!-- Stage scores -->
          <section class="grid gap-4 lg:grid-cols-[1.05fr_0.95fr]">
            <div class="card">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="card-title">Evaluasi per tahap</p>
                  <h2 class="card-heading">Skor rata-rata tiap tahap layanan</h2>
                </div>
                <span class="badge badge-muted shrink-0">Skala 1–{scoreMax}</span>
              </div>
              <div class="mt-6">
                <BarChart
                  bars={stageBars}
                  min={data?.meta.npsScale === '1-5' ? 1 : 0}
                  max={scoreMax}
                  color={COLORS.accent}
                  emptyMessage="Belum ada skor tahap layanan."
                />
              </div>
              <p class="prose-note mt-5">
                Rata-rata dihitung dari butir pertanyaan penyusun tiap tahap. Tahap kamar rawat inap
                hanya muncul bila ada pasien rawat inap yang menjawab.
              </p>
            </div>

            <div class="card">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="card-title">Detail butir</p>
                  <h2 class="card-heading">Skor tiap pertanyaan</h2>
                </div>
                <span class="badge badge-muted shrink-0">{formatNumber(data?.items.length)} butir</span>
              </div>
              <div class="mt-4 space-y-2">
                {(data?.items ?? []).map((item) => {
                  const width = item.score === null ? 0 : ((item.score - 1) / (scoreMax - 1)) * 100;
                  return (
                    <div class="flex items-center gap-3">
                      <span class="w-[45%] shrink-0 text-[12px] font-semibold leading-tight text-slate-600">{item.label}</span>
                      <div class="h-2 flex-1 overflow-hidden rounded-full bg-slate-100">
                        <div class="h-full rounded-full bg-brand-blue/70" style={`width:${Math.max(0, Math.min(100, width))}%`}></div>
                      </div>
                      <span class="w-10 shrink-0 text-right text-[12px] font-extrabold tabular-nums">{formatScore(item.score)}</span>
                    </div>
                  );
                })}
              </div>
            </div>
          </section>

          <!-- Correlation -->
          <section class="card">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <p class="card-title">Analisis hubungan</p>
                <h2 class="card-heading">Korelasi kepuasan tahap layanan dengan loyalitas (NPS)</h2>
                <p class="prose-note mt-2 max-w-3xl">
                  Koefisien korelasi Pearson (r) antara skor tahap dan skor rekomendasi tiap responden.
                  Nilai mendekati 1 berarti tahap tersebut paling menentukan loyalitas pasien.
                </p>
              </div>
              <span class="badge badge-muted shrink-0">r Pearson</span>
            </div>

            <div class="mt-6 grid gap-8 lg:grid-cols-[1.25fr_0.75fr]">
              <div class="table-wrap">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th class="w-10">#</th>
                      <th>Tahap layanan</th>
                      <th class="text-right">Skor</th>
                      <th class="text-right">r</th>
                      <th>Kekuatan</th>
                      <th>Status &amp; rekomendasi</th>
                    </tr>
                  </thead>
                  <tbody>
                    {(data?.correlations ?? []).map((row) => (
                      <tr>
                        <td class="font-extrabold text-slate-400 tabular-nums">{row.rank}</td>
                        <td class="font-bold">{row.label}</td>
                        <td class="text-right font-semibold tabular-nums">{formatScore(row.score)}</td>
                        <td class="text-right font-extrabold tabular-nums">{row.r === null ? '–' : row.r.toFixed(3)}</td>
                        <td>
                          <span class={`badge badge-${strengthTone(row.strength)}`}>{row.strength}</span>
                        </td>
                        <td class="text-slate-600">{row.recommendation}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <div>
                <p class="mb-4 text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">
                  Kekuatan korelasi
                </p>
                <BarChart
                  bars={correlationBars}
                  min={0}
                  max={1}
                  color={COLORS.primary}
                  valueFormat="correlation"
                  emptyMessage="Belum cukup data untuk menghitung korelasi."
                />
              </div>
            </div>

            {(data?.correlations[0]?.r ?? 0) >= 0.5 ? (
              <div class="mt-6 rounded-lg border border-brand-blue/20 bg-brand-blue/[0.04] p-4 text-sm leading-relaxed text-slate-700">
                <strong class="font-extrabold text-brand-ink">Temuan utama.</strong>{' '}
                {data?.correlations[0]?.label} memiliki korelasi terkuat (r = {data?.correlations[0]?.r?.toFixed(3)}) dengan loyalitas pasien.
                Perbaikan pada tahap ini berpotensi memberi dampak terbesar terhadap NPS.
              </div>
            ) : (
              <div class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm leading-relaxed text-slate-600">
                <strong class="font-extrabold text-brand-ink">Catatan.</strong> Belum ada tahap dengan korelasi kuat.
                Tambah jumlah responden agar pola hubungan lebih stabil dan dapat dijadikan dasar prioritas.
              </div>
            )}
          </section>

          <!-- Trend + breakdown -->
          <section class="grid gap-4 lg:grid-cols-[1.15fr_0.85fr]">
            <div class="card">
              <p class="card-title">Tren</p>
              <h2 class="card-heading">NPS harian</h2>
              {(data?.dailyTrend.length ?? 0) > 1 ? (
                <div class="mt-5">
                  <TrendChart points={data?.dailyTrend ?? []} />
                </div>
              ) : (
                <div class="mt-5 flex h-[180px] flex-col items-center justify-center rounded-lg border border-dashed border-slate-200 bg-slate-50 text-center">
                  <p class="text-sm font-bold text-slate-600">Baru tersedia satu hari data</p>
                  <p class="mt-1 max-w-xs text-xs leading-relaxed text-slate-500">
                    Grafik tren akan muncul otomatis setelah survei berjalan lebih dari satu hari.
                  </p>
                </div>
              )}
            </div>

            <div class="card">
              <p class="card-title">Segmentasi</p>
              <h2 class="card-heading">Berdasarkan jenis layanan</h2>
              <div class="mt-4 space-y-3">
                {(data?.serviceBreakdown ?? []).map((item) => {
                  const pct = nps && nps.total > 0 ? (item.count / nps.total) * 100 : 0;
                  return (
                    <div>
                      <div class="flex items-baseline justify-between gap-3">
                        <span class="text-[13px] font-semibold text-slate-700">{item.label}</span>
                        <span class="shrink-0 text-xs font-bold text-slate-500 tabular-nums">
                          {item.count} responden
                        </span>
                      </div>
                      <div class="mt-1 flex items-center gap-2">
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-slate-100">
                          <div class="h-full rounded-full bg-brand-blue/70" style={`width:${pct}%`}></div>
                        </div>
                        <span class="w-16 shrink-0 text-right text-[11px] font-bold tabular-nums" title="Skor NPS segmen">
                          NPS {item.nps === null ? '–' : `${item.nps > 0 ? '+' : ''}${item.nps}`}
                        </span>
                      </div>
                    </div>
                  );
                })}
              </div>

              <div class="mt-6 border-t border-slate-100 pt-4">
                <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">Jenis responden</p>
                <div class="mt-2 flex flex-wrap gap-2">
                  {(data?.respondentBreakdown ?? []).map((item) => (
                    <span class="badge badge-muted">{item.label} · {item.count}</span>
                  ))}
                </div>
              </div>
            </div>
          </section>

          <!-- Comments -->
          <section class="card">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <p class="card-title">Suara pasien</p>
                <h2 class="card-heading">Komentar &amp; masukan</h2>
              </div>
              <span class="badge badge-muted shrink-0">{formatNumber(data?.comments.length)} komentar</span>
            </div>

            {(data?.comments.length ?? 0) === 0 ? (
              <p class="mt-6 text-sm text-slate-500">Belum ada komentar yang diisi responden.</p>
            ) : (
              <div class="mt-5 grid gap-3 md:grid-cols-2">
                {(data?.comments ?? []).slice(0, 40).map((comment) => (
                  <article class="rounded-lg border border-slate-200 bg-slate-50/60 p-4">
                    <div class="flex flex-wrap items-center gap-1.5">
                      <span class="badge badge-good">{comment.stageLabel}</span>
                      {comment.serviceType && <span class="badge badge-muted">{comment.serviceType}</span>}
                      <span class="ml-auto text-[11px] font-medium text-slate-400">{formatDate(comment.submittedAt)}</span>
                    </div>
                    <p class="mt-2.5 text-sm leading-relaxed text-slate-700">{comment.text}</p>
                  </article>
                ))}
              </div>
            )}
          </section>

          <p class="prose-note pb-4">
            Laporan dibuat otomatis oleh Incentric CX Dashboard. Skor NPS dihitung dari pertanyaan rekomendasi
            {data?.meta.npsScale === '1-5' ? ' dengan skala 1–5 (5 = promoter, 4 = passive, 1–3 = detractor)' : ' dengan skala 0–10'}.
            Korelasi dihitung pada level responden dan hanya ilustratif untuk sampel kecil.
          </p>
        </>
      )}
    </main>
  </div>
</Base>
