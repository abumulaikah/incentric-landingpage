---
import Base from '../layouts/Base.astro';
import { isAdmin, sessionCookie, verifySessionToken } from '../lib/auth';
import { hasDatabase } from '../lib/db';
import { readEnv } from '../lib/env';
import {
  checkAdminPassword,
  cookieOptionsFor,
  createSessionToken,
  resetAttempts,
  tooManyAttempts,
} from '../lib/auth';

export const prerender = false;

const session = await verifySessionToken(Astro.cookies.get(sessionCookie.name)?.value);
const admin = isAdmin(session);
const dbReady = hasDatabase();
const hasTallyKey = Boolean(readEnv('TALLY_API_KEY'));

let loginError: string | null = null;

if (!admin && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const identifier = `admin-page:${Astro.clientAddress ?? 'local'}`;

  if (tooManyAttempts(identifier)) {
    loginError = 'Too many attempts. Please try again in a few minutes.';
  } else if (!checkAdminPassword(password)) {
    loginError = 'Incorrect admin password.';
  } else {
    resetAttempts(identifier);
    const token = await createSessionToken(['admin']);
    Astro.cookies.set(sessionCookie.name, token, cookieOptionsFor(Astro.url));
    return Astro.redirect('/admin');
  }
}
---

<Base title="Projects - Incentric">
  <div class="shell">
    <header class="border-b border-slate-300 bg-white">
      <div class="container-page flex items-center justify-between gap-4 py-4">
        <a href="/" class="flex items-center gap-3">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-ink text-base font-extrabold text-brand-yellow">i</span>
          <span class="text-sm font-extrabold uppercase tracking-[0.24em]">incentric</span>
        </a>
        {admin && (
          <div class="flex items-center gap-2">
            <a href="/admin/new" class="btn btn-yellow !min-h-10 !px-4">New project</a>
            <form method="POST" action="/api/logout"><button class="btn btn-outline !min-h-10 !px-4">Sign out</button></form>
          </div>
        )}
      </div>
    </header>

    <main class="container-page py-10 md:py-14">
      {!admin ? (
        <div class="mx-auto max-w-md">
          <p class="kicker">Internal</p>
          <h1 class="display mt-4">Incentric Admin</h1>
          <p class="mt-3 text-sm leading-relaxed text-slate-500">
            Manage client dashboards, service stages and question labels.
          </p>
          <form method="POST" action="/admin" class="card mt-8 space-y-4">
            <label class="block">
              <span class="stat-label">Admin password</span>
              <input name="password" type="password" required class="field mt-1.5" placeholder="Enter password" />
            </label>
            {loginError && <p class="rounded-lg bg-rose-50 p-3 text-xs font-semibold text-rose-700">{loginError}</p>}
            <button type="submit" class="btn btn-primary w-full">Sign in</button>
          </form>
        </div>
      ) : (
        <div class="space-y-8">
          <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="kicker">Internal</p>
              <h1 class="display mt-3">Client projects</h1>
              <p class="mt-3 max-w-xl text-sm leading-relaxed text-slate-500">
                Every project is one Tally form. Connect a form and the dashboard is generated
                automatically from its headings and scored questions.
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <span class={`badge ${dbReady ? 'badge-great' : 'badge-bad'}`}>
                {dbReady ? 'Database connected' : 'Database not connected'}
              </span>
              <span class={`badge ${hasTallyKey ? 'badge-good' : 'badge-bad'}`}>
                {hasTallyKey ? 'Tally key set' : 'Tally key missing'}
              </span>
            </div>
          </div>

          <section class="rounded-lg border border-slate-950 bg-brand-ink p-6 text-white md:p-8">
            <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
              <div>
                <p class="text-[11px] font-bold uppercase tracking-[0.24em] text-brand-yellow">New project</p>
                <h2 class="mt-3 max-w-xl text-2xl font-extrabold leading-tight tracking-tight text-white md:text-3xl">
                  Paste a Tally form ID. Get a dashboard.
                </h2>
                <p class="mt-3 max-w-xl text-sm leading-relaxed text-white/60">
                  Headings become service stages. Scored questions become dashboard items.
                </p>
              </div>
              <a href="/admin/new" class="btn btn-yellow shrink-0">Connect a form</a>
            </div>
          </section>

          <div id="client-list" class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" data-ready={dbReady ? '1' : '0'}>
            <p class="text-sm text-slate-500">Loading projects…</p>
          </div>

          <section class="grid gap-4 md:grid-cols-3">
            {[
              { step: '01', title: 'Duplicate the template', copy: 'Copy the Tally template and adjust the questions for the client.' },
              { step: '02', title: 'Connect the form', copy: 'Enter the client name and the Tally form ID. No configuration needed.' },
              { step: '03', title: 'Share the login', copy: 'Send the generated password and the login link to the client.' },
            ].map((item) => (
              <article class="card">
                <p class="text-2xl font-extrabold tracking-tight text-brand-blue">{item.step}</p>
                <h3 class="mt-3 text-base font-bold leading-snug">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-500">{item.copy}</p>
              </article>
            ))}
          </section>
        </div>
      )}
    </main>
  </div>

  <script>
    const list = document.getElementById('client-list');
    if (list && list.dataset.ready === '1') {
      fetch('/api/admin/clients')
        .then((response) => (response.ok ? response.json() : Promise.reject(response)))
        .then(
          (payload: { clients: { slug: string; name: string; formId: string; responses: number | null; nps: number | null }[] }) => {
            if (!payload.clients.length) {
              list.innerHTML = '<p class="text-sm text-slate-500">No projects yet. Connect your first Tally form.</p>';
              return;
            }
            list.innerHTML = payload.clients
              .map(
                (client) => `
                <article class="card flex flex-col justify-between">
                  <div>
                    <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-400">${client.slug}</p>
                    <h2 class="mt-2 text-lg font-extrabold leading-tight">${client.name}</h2>
                    <p class="mt-2 text-xs text-slate-500">Form ${client.formId}</p>
                    <p class="mt-4 text-sm font-semibold text-slate-700">
                      ${client.responses ?? 0} responses
                      <span class="ml-2 font-extrabold text-brand-blue">NPS ${client.nps === null ? '-' : client.nps}</span>
                    </p>
                  </div>
                  <div class="mt-5 flex gap-2">
                    <a href="/${client.slug}" class="btn btn-primary flex-1 !min-h-10 !px-3">Open</a>
                    <a href="/login/${client.slug}" class="btn btn-outline !min-h-10 !px-3">Client login</a>
                  </div>
                </article>`,
              )
              .join('');
          },
        )
        .catch(() => {
          list.innerHTML = '<p class="text-sm text-rose-600">Could not load projects.</p>';
        });
    }
  </script>
</Base>
