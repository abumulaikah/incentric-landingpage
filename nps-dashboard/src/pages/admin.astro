---
import Base from '../layouts/Base.astro';
import { createSessionToken, cookieOptionsFor, hasAdminPassword, isAdmin, sessionCookie, verifySessionToken, checkAdminPassword, resetAttempts, tooManyAttempts } from '../lib/auth';
import { CLIENTS } from '../lib/config';
import { isDemoMode } from '../lib/env';

export const prerender = false;

const session = await verifySessionToken(Astro.cookies.get(sessionCookie.name)?.value);
const admin = isAdmin(session);

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const identifier = `admin-form:${Astro.clientAddress ?? 'local'}`;

  if (tooManyAttempts(identifier)) {
    error = 'Terlalu banyak percobaan. Coba lagi beberapa menit lagi.';
  } else if (!checkAdminPassword(password)) {
    error = 'Kata sandi admin salah.';
  } else {
    resetAttempts(identifier);
    const token = await createSessionToken(['admin']);
    Astro.cookies.set(sessionCookie.name, token, cookieOptionsFor(Astro.url));
    return Astro.redirect('/admin');
  }
}

const configured = hasAdminPassword();
const demo = isDemoMode();
---

<Base title="Admin · Incentric NPS">
  <div class="shell">
    <header class="border-b border-slate-200 bg-white">
      <div class="container-page flex items-center justify-between gap-4 py-4">
        <a href="/" class="flex items-center gap-3">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-ink text-base font-extrabold text-brand-yellow">i</span>
          <span class="text-sm font-extrabold uppercase tracking-[0.2em]">incentric</span>
        </a>
        {admin && (
          <div class="flex items-center gap-2">
            <a href="/admin" class="btn btn-outline !min-h-10 !px-4">Daftar client</a>
            <form method="POST" action="/api/logout"><button class="btn btn-dark !min-h-10 !px-4">Keluar</button></form>
          </div>
        )}
      </div>
    </header>

    <main class="container-page py-8">
      {!admin ? (
        <div class="mx-auto max-w-md">
          <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-brand-blue">Area internal</p>
          <h1 class="mt-3 text-3xl font-extrabold tracking-tight">Admin Incentric</h1>
          <p class="mt-2 text-sm leading-relaxed text-slate-500">
            Halaman ini untuk tim Incentric melihat seluruh dashboard client.
          </p>

          <form method="POST" class="card mt-6 space-y-4">
            <div>
              <label for="password" class="mb-1.5 block text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">
                Kata sandi admin
              </label>
              <input id="password" name="password" type="password" required class="field" placeholder="••••••••" autocomplete="current-password" />
            </div>
            {error && <p class="rounded-lg bg-rose-50 p-3 text-xs font-semibold text-rose-700">{error}</p>}
            {!configured && (
              <p class="rounded-lg bg-amber-50 p-3 text-xs leading-relaxed text-amber-800">
                <code class="font-mono">ADMIN_PASSWORD</code> belum diatur di environment.
              </p>
            )}
            <button type="submit" class="btn btn-primary w-full">Masuk</button>
          </form>

          {demo && <p class="mt-4 text-xs text-slate-400">Mode demo aktif.</p>}
        </div>
      ) : (
        <div class="space-y-6">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-brand-blue">Area internal</p>
              <h1 class="mt-2 text-3xl font-extrabold tracking-tight">Daftar client</h1>
            </div>
            <span class="badge badge-muted">{CLIENTS.length} client</span>
          </div>

          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {CLIENTS.map((client) => (
              <article class="card flex flex-col justify-between">
                <div>
                  <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-slate-400">{client.slug}</p>
                  <h2 class="mt-1.5 text-lg font-extrabold leading-tight">{client.name}</h2>
                  <p class="mt-2 text-xs text-slate-500">
                    Form Tally: <code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-[11px]">{client.formId}</code>
                  </p>
                </div>
                <div class="mt-5 flex gap-2">
                  <a href={`/${client.slug}`} class="btn btn-primary flex-1 !min-h-10 !px-3">Buka</a>
                  <a href={`/login/${client.slug}`} class="btn btn-outline !min-h-10 !px-3">Login klien</a>
                </div>
              </article>
            ))}
          </div>

          <div class="card">
            <p class="card-title">Menambah client baru</p>
            <ol class="mt-3 space-y-2 text-sm leading-relaxed text-slate-600">
              <li><strong>1.</strong> Tambahkan entri baru di <code class="font-mono text-xs">src/lib/config.ts</code> pada array <code class="font-mono text-xs">CLIENTS</code>.</li>
              <li><strong>2.</strong> Set <code class="font-mono text-xs">NPS_FORM_&lt;SLUG&gt;</code> dan <code class="font-mono text-xs">NPS_PASSWORD_&lt;SLUG&gt;</code> di Vercel.</li>
              <li><strong>3.</strong> Deploy ulang. Dashboard baru otomatis tersedia di <code class="font-mono text-xs">/{`{slug}`}</code>.</li>
            </ol>
          </div>
        </div>
      )}
    </main>
  </div>
</Base>
