---
import Base from '../layouts/Base.astro';
import {
  checkAdminPassword,
  cookieOptionsFor,
  createSessionToken,
  isAdmin,
  resetAttempts,
  sessionCookie,
  tooManyAttempts,
  verifySessionToken,
} from '../lib/auth';
import { hasDatabase } from '../lib/db';
import { isDemoMode } from '../lib/env';

export const prerender = false;

const session = await verifySessionToken(Astro.cookies.get(sessionCookie.name)?.value);
const admin = isAdmin(session);
const dbReady = hasDatabase();
const demo = isDemoMode();

let loginError: string | null = null;

if (!admin && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const identifier = `admin-page:${Astro.clientAddress ?? 'local'}`;

  if (tooManyAttempts(identifier)) {
    loginError = 'Too many attempts. Please try again in a few minutes.';
  } else if (!checkAdminPassword(password)) {
    loginError = 'Incorrect admin password.';
  } else {
    resetAttempts(identifier);
    const token = await createSessionToken(['admin']);
    Astro.cookies.set(sessionCookie.name, token, cookieOptionsFor(Astro.url));
    return Astro.redirect('/admin');
  }
}
---

<Base title="Admin · Incentric NPS">
  <div class="shell">
    <header class="border-b border-slate-200 bg-white">
      <div class="container-page flex items-center justify-between gap-4 py-4">
        <a href="/" class="flex items-center gap-3">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-ink text-base font-extrabold text-brand-yellow">i</span>
          <span class="text-sm font-extrabold uppercase tracking-[0.2em]">incentric</span>
        </a>
        {admin && (
          <div class="flex items-center gap-2">
            <a href="/admin" class="btn btn-outline !min-h-10 !px-4">Clients</a>
            <form method="POST" action="/api/logout"><button class="btn btn-dark !min-h-10 !px-4">Sign out</button></form>
          </div>
        )}
      </div>
    </header>

    <main class="container-page py-8">
      {!admin ? (
        <div id="login" class="mx-auto max-w-md">
          <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-brand-blue">Internal</p>
          <h1 class="mt-2 text-3xl font-extrabold tracking-tight">Incentric Admin</h1>
          <p class="mt-2 text-sm text-slate-500">Manage client dashboards, stages and question labels.</p>
          <form method="POST" action="/admin" class="card mt-6 space-y-4">
            <label class="block">
              <span class="mb-1.5 block text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">Admin password</span>
              <input name="password" type="password" required class="field" placeholder="••••••••" />
            </label>
            {loginError && <p class="rounded-lg bg-rose-50 p-3 text-xs font-semibold text-rose-700">{loginError}</p>}
            <button type="submit" class="btn btn-primary w-full">Sign in</button>
          </form>
          {demo && <p class="mt-4 text-xs text-slate-400">Demo mode is active.</p>}
        </div>
      ) : (
        <div class="space-y-6">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-brand-blue">Internal</p>
              <h1 class="mt-2 text-3xl font-extrabold tracking-tight">Clients</h1>
            </div>
            <div class="flex items-center gap-2">
              <span class={`badge ${dbReady ? 'badge-great' : 'badge-warn'}`}>{dbReady ? 'Database connected' : 'Database not connected'}</span>
              <a href="/admin" class="btn btn-outline !min-h-10 !px-4">Refresh</a>
            </div>
          </div>

          <div class="card">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <p class="card-title">Add client</p>
                <h2 class="card-heading">Create a dashboard from a Tally form</h2>
                <p class="prose-note mt-2 max-w-2xl">
                  The system reads Tally headings as service stages and turns every scored question into a dashboard item with a short label.
                </p>
              </div>
              <a href="/admin/new" class="btn btn-primary">Add new client</a>
            </div>
          </div>

          <div id="client-list" class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" data-ready={dbReady ? '1' : '0'}></div>

          <div class="card">
            <p class="card-title">How a new client is added</p>
            <ol class="mt-3 space-y-2 text-sm leading-relaxed text-slate-600">
              <li><strong>1.</strong> Duplicate the Tally template and adjust the questions for the client.</li>
              <li><strong>2.</strong> Click <em>Add new client</em> and enter the name and Tally form ID.</li>
              <li><strong>3.</strong> Review stage names and question labels, then save with a client password.</li>
              <li><strong>4.</strong> Share the login link <code class="font-mono text-xs">/login/&lt;slug&gt;</code> with the client.</li>
            </ol>
          </div>
        </div>
      )}
    </main>
  </div>

  <script>
    const list = document.getElementById('client-list');
    if (list && list.dataset.ready === '1') {
      fetch('/api/admin/clients')
        .then((response) => (response.ok ? response.json() : Promise.reject(response)))
        .then(
          (payload: { clients: { slug: string; name: string; formId: string; responses: number | null; nps: number | null }[] }) => {
            list.innerHTML = payload.clients
              .map(
                (client) => `
                <article class="card">
                  <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-slate-400">${client.slug}</p>
                  <h2 class="mt-1.5 text-lg font-extrabold leading-tight">${client.name}</h2>
                  <p class="mt-2 text-xs text-slate-500">Form ${client.formId}</p>
                  <p class="mt-3 text-sm font-semibold text-slate-700">
                    ${client.responses ?? 0} responses
                    <span class="ml-2 text-brand-blue">NPS ${client.nps === null ? '–' : client.nps}</span>
                  </p>
                  <div class="mt-4 flex gap-2">
                    <a href="/${client.slug}" class="btn btn-primary flex-1 !min-h-10 !px-3">Open</a>
                    <a href="/login/${client.slug}" class="btn btn-outline !min-h-10 !px-3">Client login</a>
                  </div>
                </article>`,
              )
              .join('');
          },
        )
        .catch(() => {
          list.innerHTML = '<p class="text-sm text-rose-600">Could not load clients.</p>';
        });
    }
  </script>
</Base>
