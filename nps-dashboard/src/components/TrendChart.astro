---
/** Grafik garis sederhana untuk tren NPS harian. */
interface Point {
  date: string;
  nps: number | null;
  count: number;
}

interface Props {
  points: Point[];
}

const { points } = Astro.props;
const valid = points.filter((point) => point.nps !== null);
const width = 640;
const height = 180;
const padX = 8;
const padY = 16;

const values = valid.map((point) => point.nps as number);
const maxValue = values.length ? Math.max(...values, 0) : 100;
const minValue = values.length ? Math.min(...values, 0) : 0;
const span = maxValue - minValue || 1;

const coords = valid.map((point, index) => {
  const x = valid.length === 1 ? width / 2 : padX + (index / (valid.length - 1)) * (width - padX * 2);
  const y = height - padY - (((point.nps as number) - minValue) / span) * (height - padY * 2);
  return { ...point, x, y };
});

const linePath = coords.map((point, index) => `${index === 0 ? 'M' : 'L'}${point.x.toFixed(1)},${point.y.toFixed(1)}`).join(' ');
const areaPath = coords.length
  ? `${linePath} L${coords[coords.length - 1].x.toFixed(1)},${height} L${coords[0].x.toFixed(1)},${height} Z`
  : '';
const zeroY = height - padY - ((0 - minValue) / span) * (height - padY * 2);
---

{coords.length === 0 ? (
  <p class="py-10 text-center text-sm text-slate-500">Belum ada data tren.</p>
) : (
  <div>
    <svg viewBox={`0 0 ${width} ${height}`} class="h-44 w-full" role="img" aria-label="Tren NPS harian">
      <defs>
        <linearGradient id="npsArea" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#014fcf" stop-opacity="0.18" />
          <stop offset="100%" stop-color="#014fcf" stop-opacity="0" />
        </linearGradient>
      </defs>
      {minValue < 0 && (
        <line x1="0" y1={zeroY} x2={width} y2={zeroY} stroke="#cbd5e1" stroke-dasharray="4 4" stroke-width="1" />
      )}
      <path d={areaPath} fill="url(#npsArea)" />
      <path d={linePath} fill="none" stroke="#014fcf" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      {coords.map((point) => (
        <g>
          <circle cx={point.x} cy={point.y} r="4" fill="#fff" stroke="#014fcf" stroke-width="2.5" />
          <title>{point.date}: NPS {point.nps} ({point.count} respons)</title>
        </g>
      ))}
    </svg>
    <div class="mt-2 flex justify-between text-[11px] font-medium text-slate-500">
      <span>{valid[0].date}</span>
      <span>{valid[valid.length - 1].date}</span>
    </div>
  </div>
)}
