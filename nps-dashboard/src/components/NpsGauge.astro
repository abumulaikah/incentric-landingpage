---
interface Props {
  score: number | null;
  metaScore?: number | null;
  metaLabel?: string;
}

const { score, metaScore = null, metaLabel } = Astro.props;
const hasScore = typeof score === 'number';
const band = !hasScore
  ? { label: 'Belum ada data', tone: 'bad' as const }
  : score >= 50
    ? { label: 'Sangat baik', tone: 'great' as const }
    : score >= 0
      ? { label: 'Baik', tone: 'good' as const }
      : score >= -50
        ? { label: 'Perlu perhatian', tone: 'warn' as const }
        : { label: 'Kritis', tone: 'bad' as const };

const toneClass = {
  great: 'badge-great',
  good: 'badge-good',
  warn: 'badge-warn',
  bad: 'badge-bad',
}[band.tone];

// Posisi penanda pada skala -100..100.
const markerPct = hasScore ? Math.max(0, Math.min(100, ((score + 100) / 200) * 100)) : 50;
---

<div>
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
    <span class="text-[2.6rem] font-extrabold leading-none tracking-tight tabular-nums md:text-5xl">
      {hasScore ? `${score > 0 ? '+' : ''}${score}` : '–'}
    </span>
    <span class={`badge ${toneClass}`}>{band.label}</span>
  </div>

  <div class="mt-6">
    <div class="relative h-3 w-full overflow-hidden rounded-full bg-gradient-to-r from-rose-500 via-amber-300 to-brand-blue">
      {hasScore && (
        <span
          class="absolute top-1/2 h-5 w-5 -translate-x-1/2 -translate-y-1/2 rounded-full border-[3px] border-white bg-brand-ink shadow"
          style={`left:${markerPct}%`}
        ></span>
      )}
    </div>
    <div class="mt-1.5 flex justify-between text-[10px] font-semibold uppercase tracking-wider text-slate-400">
      <span>-100</span>
      <span>0</span>
      <span>+100</span>
    </div>
  </div>

  {metaScore !== null && metaScore !== undefined && (
    <p class="mt-4 border-t border-slate-100 pt-3 text-xs font-medium text-slate-500">
      {metaLabel ?? 'Rata-rata skor rekomendasi'}: <span class="font-bold text-slate-700 tabular-nums">{metaScore}</span>
    </p>
  )}
</div>
