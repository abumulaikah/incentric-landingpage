---
/**
 * Donut chart proporsi loyalitas (Promoter / Passive / Detractor).
 * Digambar dengan SVG murni agar tidak menambah dependency runtime.
 */
interface Slice {
  label: string;
  value: number;
  count: number;
  color: string;
}

interface Props {
  slices: Slice[];
  total: number;
  centerValue: string;
  centerLabel: string;
}

const { slices, total, centerValue, centerLabel } = Astro.props;

const sum = slices.reduce((acc, slice) => acc + slice.value, 0);
const denominator = sum > 0 ? sum : total;
const radius = 62;
const stroke = 26;
const circumference = 2 * Math.PI * radius;

let offset = 0;
const arcs = slices
  .filter((slice) => slice.value > 0)
  .map((slice) => {
    const length = (slice.value / denominator) * circumference;
    const arc = { ...slice, length, offset };
    offset += length;
    return arc;
  });
---

<div class="flex flex-col items-center gap-6 sm:flex-row sm:items-center sm:gap-8">
  <div class="relative shrink-0">
    <svg viewBox="0 0 160 160" class="h-44 w-44 -rotate-90" role="img" aria-label="Proporsi loyalitas pasien">
      <circle cx="80" cy="80" r={radius} fill="none" stroke="#f1f5f9" stroke-width={stroke} />
    </svg>
    <div class="pointer-events-none absolute inset-0 -rotate-90">
      <svg viewBox="0 0 160 160" class="h-44 w-44" aria-hidden="true">
        <circle cx="80" cy="80" r={radius} fill="none" stroke="#f1f5f9" stroke-width={stroke} />
        {arcs.map((arc) => (
          <circle
            cx="80"
            cy="80"
            r={radius}
            fill="none"
            stroke={arc.color}
            stroke-width={stroke}
            stroke-dasharray={`${arc.length} ${circumference - arc.length}`}
            stroke-dashoffset={-arc.offset}
            stroke-linecap="butt"
          />
        ))}
      </svg>
    </div>
    <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center">
      <span class="text-3xl font-extrabold leading-none tracking-tight">{centerValue}</span>
      <span class="mt-1 text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">{centerLabel}</span>
    </div>
  </div>

  <ul class="w-full space-y-3">
    {slices.map((slice) => (
      <li class="flex items-center justify-between gap-3">
        <span class="flex items-center gap-2 text-sm font-semibold text-slate-700">
          <span class="h-3 w-3 shrink-0 rounded-sm" style={`background:${slice.color}`}></span>
          {slice.label}
        </span>
        <span class="text-right">
          <span class="text-sm font-extrabold tabular-nums">{slice.value.toFixed(1)}%</span>
          <span class="ml-2 text-xs font-medium text-slate-500 tabular-nums">{slice.count}</span>
        </span>
      </li>
    ))}
  </ul>
</div>
