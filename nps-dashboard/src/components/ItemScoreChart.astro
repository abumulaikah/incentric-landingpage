---
/**
 * Grafik vertikal skor tiap butir pertanyaan dengan baseline 3.
 * Butir diurutkan mengikuti alur layanan, dari kiri ke kanan.
 * Skor di bawah baseline ditandai merah, di atas hijau.
 */
interface Item {
  key: string;
  label: string;
  score: number | null;
  responses: number;
  stageKey: string | null;
}

interface Stage {
  key: string;
  shortLabel: string;
}

interface Props {
  items: Item[];
  stages: Stage[];
  max: number;
  /** Minimum sumbu Y. Default 3 agar naik-turun lebih terlihat. */
  axisMin?: number;
}

const { items, stages, max, axisMin = 3 } = Astro.props;

// Skala sumbu Y dipersempit (3–5) agar naik-turun grafik lebih terlihat.
const min = axisMin;

const formatScoreLocal = (value: number | null) =>
  value === null ? '–' : new Intl.NumberFormat('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(value);

const scoreRange = max - min || 1;

// Baseline di 3, dibatasi agar tetap dalam rentang skala.
const baseline = Math.min(max, Math.max(min, 3));

const points = items.filter((item) => item.score !== null);

const labelWidth = 132;
const plotWidth = points.length * 92 + labelWidth;
const plotHeight = 330;

const padTop = 30;
const padBottom = 62;
const plotLeft = labelWidth + 14;
const plotRight = plotWidth - 18;
const usable = plotHeight - padTop - padBottom;

const xOf = (index: number) =>
  points.length === 1 ? (plotLeft + plotRight) / 2 : plotLeft + (index * (plotRight - plotLeft)) / (points.length - 1);
const yOf = (value: number) => padTop + ((max - value) / scoreRange) * usable;

const baselineY = yOf(baseline);
const linePath = points.map((item, index) => `${index === 0 ? 'M' : 'L'}${xOf(index).toFixed(1)},${yOf(item.score as number).toFixed(1)}`).join(' ');

const ticks: number[] = [];
for (let value = max; value >= min - 0.0001; value -= 1) ticks.push(Number(value.toFixed(2)));

const labelLines = (label: string) => {
  const words = label.split(' ');
  const lines: string[] = [];
  let current = '';
  for (const word of words) {
    if (`${current} ${word}`.trim().length > 13 && current) {
      lines.push(current);
      current = word;
    } else {
      current = `${current} ${word}`.trim();
    }
  }
  if (current) lines.push(current);
  return lines.slice(0, 2);
};

const stageAnchors = points.map((item, index) => {
  const previous = index > 0 ? points[index - 1] : null;
  return { item, index, startsStage: !previous || previous.stageKey !== item.stageKey };
});

const sorted = [...points].sort((a, b) => (a.score as number) - (b.score as number));
const lowPoints = sorted.slice(0, 2);
const highPoints = sorted.slice(-2).reverse();
const belowBaseline = points.filter((item) => (item.score as number) < baseline);
---

{items.length === 0 ? (
  <p class="py-10 text-center text-sm text-slate-500">Belum ada skor butir pertanyaan.</p>
) : (
  <div class="space-y-6">
    <div class="overflow-x-auto">
      <svg
        viewBox={`0 0 ${plotWidth} ${plotHeight}`}
        width="100%"
        style={`min-width:${plotWidth}px;max-width:${plotWidth}px`}
        role="img"
        aria-label="Tren skor tiap butir pertanyaan (skala 3 sampai 5)"
      >
        <defs>
          <linearGradient id="itemTrendArea" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#014fcf" stop-opacity="0.12" />
            <stop offset="100%" stop-color="#014fcf" stop-opacity="0" />
          </linearGradient>
        </defs>

        <!-- kisi skala -->
        {ticks.map((tick) => (
          <g>
            <line
              x1={plotLeft}
              y1={yOf(tick).toFixed(1)}
              x2={plotRight}
              y2={yOf(tick).toFixed(1)}
              stroke="#eef2f7"
              stroke-width="1"
            />
            <text x={plotLeft - 10} y={yOf(tick) + 3.5} text-anchor="end" class="fill-slate-400" style="font-size:9.5px;font-weight:600">
              {tick.toFixed(0)}
            </text>
          </g>
        ))}

        <!-- area di bawah baseline -->
        <rect x={plotLeft} y={baselineY} width={plotRight - plotLeft} height={Math.max(0, yOf(min) - baselineY)} fill="#fef2f2" opacity="0.7" />

        <!-- garis baseline -->
        <line x1={plotLeft} y1={baselineY.toFixed(1)} x2={plotRight} y2={baselineY.toFixed(1)} stroke="#e11d48" stroke-width="1.5" stroke-dasharray="6 4" />
        <text x={plotRight} y={baselineY - 6} text-anchor="end" class="fill-rose-600" style="font-size:9px;font-weight:800;letter-spacing:0.04em">
          BASELINE {baseline.toFixed(0)}
        </text>

        <!-- pemisah tahap -->
        {stageAnchors
          .filter((anchor) => anchor.startsStage && anchor.index > 0)
          .map((anchor) => (
            <line
              x1={(xOf(anchor.index) - 46).toFixed(1)}
              y1={padTop}
              x2={(xOf(anchor.index) - 46).toFixed(1)}
              y2={plotHeight - padBottom}
              stroke="#e2e8f0"
              stroke-width="1"
              stroke-dasharray="4 4"
            />
          ))}

        <!-- garis tren -->
        {points.length > 1 && (
          <path d={linePath} fill="none" stroke="#0f172a" stroke-width="2.25" stroke-linejoin="round" stroke-linecap="round" />
        )}

        <!-- titik + label nilai -->
        {points.map((item, index) => {
          const value = item.score as number;
          const below = value < baseline;
          return (
            <g>
              <circle
                cx={xOf(index).toFixed(1)}
                cy={yOf(value).toFixed(1)}
                r="5"
                fill={below ? '#e11d48' : '#ffbc00'}
                stroke="#0f172a"
                stroke-width="2"
              >
                <title>{item.label}: {formatScoreLocal(item.score)}</title>
              </circle>
              <text
                x={xOf(index).toFixed(1)}
                y={(yOf(value) - 12).toFixed(1)}
                text-anchor="middle"
                class={below ? 'fill-rose-600' : 'fill-slate-900'}
                style="font-size:10px;font-weight:800"
              >
                {formatScoreLocal(item.score)}
              </text>
            </g>
          );
        })}

        <!-- label pertanyaan (dibungkus dua baris) + penanda tahap -->
        {points.map((item, index) => (
          <g>
            {labelLines(item.label).map((line, lineIndex) => (
              <text
                x={xOf(index).toFixed(1)}
                y={(plotHeight - padBottom + 16 + lineIndex * 11).toFixed(1)}
                text-anchor="middle"
                class="fill-slate-600"
                style="font-size:9.5px;font-weight:700"
              >
                {line}
              </text>
            ))}
          </g>
        ))}

        {stageAnchors
          .filter((anchor) => anchor.startsStage)
          .map((anchor) => (
            <text
              x={xOf(anchor.index).toFixed(1)}
              y={plotHeight - 4}
              text-anchor="middle"
              class="fill-brand-blue/70"
              style="font-size:8px;font-weight:800;letter-spacing:0.05em"
            >
              {(stages.find((stage) => stage.key === anchor.item.stageKey)?.shortLabel ?? '').toUpperCase()}
            </text>
          ))}
      </svg>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      <div class="rounded-lg bg-rose-50/70 px-4 py-3">
        <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-rose-600">Titik terendah</p>
        <p class="mt-1.5 text-[12px] font-semibold leading-relaxed text-slate-700">
          {lowPoints.map((item, index) => `${index > 0 ? ' · ' : ''}${item.label} (${formatScoreLocal(item.score)})`).join('') || '–'}
        </p>
      </div>
      <div class="rounded-lg bg-emerald-50/70 px-4 py-3">
        <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-emerald-700">Titik tertinggi</p>
        <p class="mt-1.5 text-[12px] font-semibold leading-relaxed text-slate-700">
          {highPoints.map((item, index) => `${index > 0 ? ' · ' : ''}${item.label} (${formatScoreLocal(item.score)})`).join('') || '–'}
        </p>
      </div>
    </div>

    <p class="text-[11px] leading-relaxed text-slate-500">
      Sumbu skor dimulai dari {min.toFixed(0)} agar perbedaan antar tahap lebih terlihat.
      Garis putus-putus merah adalah <strong class="font-bold text-slate-700">baseline {baseline.toFixed(0)}</strong>.
      {belowBaseline.length === 0
        ? 'Semua butir berada di atas baseline.'
        : `${belowBaseline.length} butir berada di bawah baseline: ${belowBaseline.map((item) => item.label).join(', ')}.`}
    </p>
  </div>
)}
