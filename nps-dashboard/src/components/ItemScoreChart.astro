---
/**
 * Grafik garis tren skor tiap butir pertanyaan.
 * Tanpa bar chart — fokus pada naik-turun pengalaman antar titik layanan.
 * Tata letak: label pertanyaan di kiri (tidak terpotong), grafik di kanan.
 */
interface Item {
  key: string;
  label: string;
  score: number | null;
  responses: number;
  stageKey: string | null;
}

interface Stage {
  key: string;
  shortLabel: string;
}

interface Props {
  items: Item[];
  stages: Stage[];
  min: number;
  max: number;
}

const { items, stages, min, max } = Astro.props;

const formatScoreLocal = (value: number | null) =>
  value === null ? '–' : new Intl.NumberFormat('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(value);

const points = items.filter((item) => item.score !== null);

const labelWidth = 150;
const chartWidth = 380;
const rowHeight = 34;
const padTop = 14;
const padBottom = 10;
const padRight = 16;
const plotWidth = labelWidth + chartWidth + padRight;
const plotHeight = points.length * rowHeight + padTop + padBottom;

const plotLeft = labelWidth + 26;
const plotRight = plotWidth - padRight;

const xOf = (value: number) => plotLeft + ((value - min) / (max - min || 1)) * (plotRight - plotLeft);
const yOf = (index: number) => padTop + index * rowHeight + rowHeight / 2;

const linePath = points.map((item, index) => `${index === 0 ? 'M' : 'L'}${xOf(item.score as number).toFixed(1)},${yOf(index).toFixed(1)}`).join(' ');

const ticks: number[] = [];
const tickStep = max - min <= 1 ? 0.5 : 1;
for (let value = min; value <= max + 0.0001; value += tickStep) ticks.push(Number(value.toFixed(2)));

// Batas antar tahap untuk baris pemisah.
const stageBreaks: { y: number; label: string }[] = [];
let previousStage: string | null = null;
for (const [index, item] of points.entries()) {
  if (item.stageKey !== previousStage) {
    if (index > 0) {
      stageBreaks.push({
        y: padTop + index * rowHeight,
        label: stages.find((stage) => stage.key === item.stageKey)?.shortLabel ?? '',
      });
    }
    previousStage = item.stageKey;
  }
}

const sorted = [...points].sort((a, b) => (a.score as number) - (b.score as number));
const lowPoints = sorted.slice(0, 2);
const highPoints = sorted.slice(-2).reverse();
---

{items.length === 0 ? (
  <p class="py-10 text-center text-sm text-slate-500">Belum ada skor butir pertanyaan.</p>
) : (
  <div class="space-y-6">
    <div class="overflow-x-auto">
      <svg
        viewBox={`0 0 ${plotWidth} ${plotHeight}`}
        width="100%"
        style={`min-width:${plotWidth}px;max-width:${plotWidth}px`}
        role="img"
        aria-label="Tren skor tiap butir pertanyaan"
      >
        <defs>
          <linearGradient id="itemRowFill" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#f8fafc" stop-opacity="0" />
            <stop offset="100%" stop-color="#f1f5f9" stop-opacity="0.9" />
          </linearGradient>
        </defs>

        <!-- grid vertikal + skala -->
        {ticks.map((tick) => (
          <g>
            <line
              x1={xOf(tick).toFixed(1)}
              y1={padTop}
              x2={xOf(tick).toFixed(1)}
              y2={plotHeight - padBottom}
              stroke={Number.isInteger(tick) ? '#d7dee8' : '#eef2f7'}
              stroke-width="1"
              stroke-dasharray={Number.isInteger(tick) ? undefined : '3 4'}
            />
            <text
              x={xOf(tick).toFixed(1)}
              y={plotHeight - padBottom + 14}
              text-anchor="middle"
              class="fill-slate-400"
              style="font-size:9.5px;font-weight:600"
            >
              {tick.toFixed(1)}
            </text>
          </g>
        ))}

        <!-- pemisah tahap -->
        {stageBreaks.map((stage) => (
          <g>
            <line
              x1={labelWidth - 4}
              y1={stage.y}
              x2={plotRight}
              y2={stage.y}
              stroke="#e2e8f0"
              stroke-width="1"
              stroke-dasharray="4 4"
            />
            <text
              x={xOf(min) + 2}
              y={stage.y - 5}
              class="fill-brand-blue/60"
              style="font-size:8.5px;font-weight:800;letter-spacing:0.06em"
            >
              {stage.label.toUpperCase()}
            </text>
          </g>
        ))}

        <!-- label pertanyaan di kiri -->
        {points.map((item, index) => (
          <text
            x={labelWidth}
            y={yOf(index) + 3.5}
            text-anchor="end"
            class="fill-slate-700"
            style="font-size:10.5px;font-weight:700"
          >
            {item.label}
          </text>
        ))}

        <!-- garis tren -->
        {points.length > 1 && (
          <path d={linePath} fill="none" stroke="#0f172a" stroke-width="2.25" stroke-linejoin="round" stroke-linecap="round" />
        )}

        {points.map((item, index) => (
          <g>
            <circle
              cx={xOf(item.score as number).toFixed(1)}
              cy={yOf(index).toFixed(1)}
              r="5"
              fill="#ffbc00"
              stroke="#0f172a"
              stroke-width="2"
            >
              <title>{item.label}: {formatScoreLocal(item.score)}</title>
            </circle>
            <text
              x={(xOf(item.score as number) + 9).toFixed(1)}
              y={yOf(index) + 3.5}
              class="fill-slate-900"
              style="font-size:10px;font-weight:800"
            >
              {formatScoreLocal(item.score)}
            </text>
          </g>
        ))}

        <text x={labelWidth} y={plotHeight - 2} text-anchor="end" class="fill-slate-400" style="font-size:8.5px;font-weight:700">
          PERTANYAAN
        </text>
        <text x={(plotLeft + plotRight) / 2} y={plotHeight - 2} text-anchor="middle" class="fill-slate-400" style="font-size:8.5px;font-weight:700">
          SKOR ({min}–{max})
        </text>
      </svg>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      <div class="rounded-lg bg-rose-50/70 px-4 py-3">
        <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-rose-600">Titik terendah</p>
        <p class="mt-1.5 text-[12px] font-semibold leading-relaxed text-slate-700">
          {lowPoints.map((item, index) => `${index > 0 ? ' · ' : ''}${item.label} (${formatScoreLocal(item.score)})`).join('') || '–'}
        </p>
      </div>
      <div class="rounded-lg bg-emerald-50/70 px-4 py-3">
        <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-emerald-700">Titik tertinggi</p>
        <p class="mt-1.5 text-[12px] font-semibold leading-relaxed text-slate-700">
          {highPoints.map((item, index) => `${index > 0 ? ' · ' : ''}${item.label} (${formatScoreLocal(item.score)})`).join('') || '–'}
        </p>
      </div>
    </div>
  </div>
)}
