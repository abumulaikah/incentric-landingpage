---
/**
 * Grafik vertikal skor tiap butir + garis tren.
 * Membantu melihat naik-turunnya pengalaman antar titik layanan.
 */
interface Item {
  key: string;
  label: string;
  score: number | null;
  responses: number;
  stageKey: string | null;
}

interface Stage {
  key: string;
  shortLabel: string;
}

interface Props {
  items: Item[];
  stages: Stage[];
  min: number;
  max: number;
}

const { items, stages, min, max } = Astro.props;

const formatScoreLocal = (value: number | null) =>
  value === null ? '–' : new Intl.NumberFormat('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(value);

const points = items.filter((item) => item.score !== null);
const plotHeight = 210;
const plotWidth = Math.max(points.length * 92, 360);
const padTop = 10;
const padBottom = 6;
const leftPad = 34;

const usableHeight = plotHeight - padTop - padBottom;
const xOf = (index: number) =>
  points.length === 1 ? plotWidth / 2 : leftPad + 18 + (index * (plotWidth - leftPad - 36)) / (points.length - 1);
const yOf = (value: number) => padTop + ((max - value) / (max - min || 1)) * usableHeight;
const barTop = (value: number) => padTop + ((max - value) / (max - min || 1)) * usableHeight;

const linePath = points.map((item, index) => `${index === 0 ? 'M' : 'L'}${xOf(index).toFixed(1)},${yOf(item.score as number).toFixed(1)}`).join(' ');
const areaPath = points.length
  ? `${linePath} L${xOf(points.length - 1).toFixed(1)},${plotHeight - padBottom} L${xOf(0).toFixed(1)},${plotHeight - padBottom} Z`
  : '';

const barWidth = points.length === 0 ? 0 : Math.min(34, Math.max(14, (plotWidth - leftPad) / points.length - 24));

const ticks: number[] = [];
const tickStep = max - min <= 1 ? 0.25 : 1;
for (let value = min; value <= max + 0.0001; value += tickStep) ticks.push(Number(value.toFixed(2)));
if (ticks.length > 9) {
  const reduce = Math.ceil(ticks.length / 6);
  ticks.splice(0, ticks.length, ...ticks.filter((_, index) => index % reduce === 0 || index === ticks.length - 1));
}

const lowPoints = [...points].sort((a, b) => (a.score as number) - (b.score as number)).slice(0, 2);
const highPoints = [...points].sort((a, b) => (b.score as number) - (a.score as number)).slice(0, 2);
---

{items.length === 0 ? (
  <p class="py-8 text-center text-sm text-slate-500">Belum ada skor butir pertanyaan.</p>
) : (
  <div>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-4 text-[11px] font-semibold text-slate-600">
        <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm bg-brand-blue/45"></span> Skor butir</span>
        <span class="flex items-center gap-1.5">
          <span class="h-0.5 w-4 rounded-full bg-brand-ink"></span>
          <span class="h-2.5 w-2.5 rounded-full border-2 border-brand-ink bg-brand-yellow"></span>
          Garis tren
        </span>
      </div>
      <span class="badge badge-muted">Skala {min}–{max}</span>
    </div>

    <div class="mt-3 overflow-x-auto pb-2">
      <svg viewBox={`0 0 ${plotWidth} ${plotHeight}`} width={plotWidth} height={plotHeight} class="block" role="img" aria-label="Skor tiap butir pertanyaan dengan garis tren">
        <defs>
          <linearGradient id="itemTrendFill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#ffbc00" stop-opacity="0.16" />
            <stop offset="100%" stop-color="#ffbc00" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="itemBarFill" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0%" stop-color="#014fcf" stop-opacity="0.32" />
            <stop offset="100%" stop-color="#014fcf" stop-opacity="0.75" />
          </linearGradient>
        </defs>

        {ticks.map((tick) => (
          <g>
            <line
              x1={leftPad}
              y1={yOf(tick).toFixed(1)}
              x2={plotWidth}
              y2={yOf(tick).toFixed(1)}
              stroke={Number.isInteger(tick) ? '#d7dee8' : '#eef2f7'}
              stroke-width="1"
              stroke-dasharray={Number.isInteger(tick) ? undefined : '3 4'}
            />
            <text x={leftPad - 7} y={yOf(tick) + 3.5} text-anchor="end" class="fill-slate-400" style="font-size:10px;font-weight:600">
              {tick.toFixed(2)}
            </text>
          </g>
        ))}

        {points.map((item, index) => (
          <rect
            x={(xOf(index) - barWidth / 2).toFixed(1)}
            y={barTop(item.score as number).toFixed(1)}
            width={barWidth.toFixed(1)}
            height={Math.max(1, plotHeight - padBottom - barTop(item.score as number)).toFixed(1)}
            rx="4"
            fill="url(#itemBarFill)"
          >
            <title>{item.label}: {formatScoreLocal(item.score)}</title>
          </rect>
        ))}

        {points.length > 1 && (
          <g>
            <path d={areaPath} fill="url(#itemTrendFill)" />
            <path d={linePath} fill="none" stroke="#0f172a" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
            {points.map((item, index) => (
              <circle
                cx={xOf(index).toFixed(1)}
                cy={yOf(item.score as number).toFixed(1)}
                r="4.5"
                fill="#ffbc00"
                stroke="#0f172a"
                stroke-width="2"
              >
                <title>{item.label}: {formatScoreLocal(item.score)}</title>
              </circle>
            ))}
          </g>
        )}

        {points.map((item, index) => (
          <g>
            <text
              x={xOf(index).toFixed(1)}
              y={(yOf(item.score as number) - 12).toFixed(1)}
              text-anchor="middle"
              class="fill-slate-900"
              style="font-size:10.5px;font-weight:800"
            >
              {formatScoreLocal(item.score)}
            </text>
            <text
              x={xOf(index).toFixed(1)}
              y={plotHeight - 1}
              text-anchor="middle"
              class="fill-slate-500"
              style="font-size:9.5px;font-weight:700"
            >
              {item.label.length > 15 ? `${item.label.slice(0, 14)}…` : item.label}
            </text>
          </g>
        ))}
      </svg>
    </div>

    <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[10px] font-semibold text-slate-500">
      {stages.map((stage) => (
        <li>
          <span class="uppercase tracking-wider text-brand-blue/70">{stage.shortLabel}</span>
          <span class="ml-1 text-slate-600">
            {formatScoreLocal(
              (() => {
                const values = items.filter((item) => item.stageKey === stage.key && item.score !== null).map((item) => item.score as number);
                return values.length ? values.reduce((a, b) => a + b, 0) / values.length : null;
              })(),
            )}
          </span>
        </li>
      ))}
    </ul>

    <div class="mt-4 grid gap-2 border-t border-slate-100 pt-3 sm:grid-cols-2">
      <p class="text-[11px] leading-relaxed text-slate-500">
        <span class="font-bold text-rose-600">Terendah:</span>
        {lowPoints.map((item, index) => `${index > 0 ? ', ' : ''}${item.label} (${formatScoreLocal(item.score)})`).join('') || '–'}
      </p>
      <p class="text-[11px] leading-relaxed text-slate-500 sm:text-right">
        <span class="font-bold text-emerald-600">Tertinggi:</span>
        {highPoints.map((item, index) => `${index > 0 ? ', ' : ''}${item.label} (${formatScoreLocal(item.score)})`).join('') || '–'}
      </p>
    </div>
  </div>
)}
