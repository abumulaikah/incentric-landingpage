---
/**
 * Grafik vertikal skor tiap butir pertanyaan (satu baris penuh).
 * Sumbu Y di-zoom ke 3–5 agar naik-turun pengalaman terlihat jelas.
 */
interface Item {
  key: string;
  label: string;
  score: number | null;
  responses: number;
  stageKey: string | null;
}

interface Stage {
  key: string;
  shortLabel: string;
}

interface Props {
  items: Item[];
  stages: Stage[];
  max: number;
  /** Minimum sumbu Y. Default 3 agar naik-turun lebih terlihat. */
  axisMin?: number;
}

const { items, stages, max, axisMin = 3 } = Astro.props;

const min = axisMin;

const formatScoreLocal = (value: number | null) =>
  value === null ? '–' : new Intl.NumberFormat('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(value);

const points = items.filter((item) => item.score !== null);

const columnWidth = 104;
const labelWidth = 34;
const plotWidth = points.length * columnWidth + labelWidth;
const plotHeight = 420;

const axisY = 306;
const padTop = 34;
const plotLeft = labelWidth + 8;
const plotRight = plotWidth - 52;
const usable = axisY - padTop;
const scoreRange = max - min || 1;

// Jarak vertikal area sumbu X.
const axisLabelGap = 18; // garis sumbu → baris label pertama
const labelLineHeight = 13; // antar baris label
const labelBlockBottom = axisLabelGap + labelLineHeight + 8;
const groupDividerY = axisY + labelBlockBottom + 10;
const groupLabelY = axisY + labelBlockBottom + 24;

const xOf = (index: number) =>
  points.length === 1 ? (plotLeft + plotRight) / 2 : plotLeft + (index * (plotRight - plotLeft)) / (points.length - 1);
const yOf = (value: number) => padTop + ((max - value) / scoreRange) * usable;

const baseline = Math.min(max, Math.max(min, 3));

const linePath = points.map((item, index) => `${index === 0 ? 'M' : 'L'}${xOf(index).toFixed(1)},${yOf(item.score as number).toFixed(1)}`).join(' ');

const ticks: number[] = [];
const tickStep = scoreRange <= 2 ? 0.5 : 1;
for (let value = max; value >= min - 0.0001; value -= tickStep) ticks.push(Number(value.toFixed(2)));

const wrapLabel = (label: string) => {
  const words = label.split(' ');
  const lines: string[] = [];
  let current = '';
  for (const word of words) {
    if (`${current} ${word}`.trim().length > 14 && current) {
      lines.push(current);
      current = word;
    } else {
      current = `${current} ${word}`.trim();
    }
  }
  if (current) lines.push(current);
  return lines.slice(0, 2);
};

const stageAnchors = points.map((item, index) => {
  const previous = index > 0 ? points[index - 1] : null;
  return { item, index, startsStage: !previous || previous.stageKey !== item.stageKey };
});

const sorted = [...points].sort((a, b) => (a.score as number) - (b.score as number));
const lowPoints = sorted.slice(0, 2);
const highPoints = sorted.slice(-2).reverse();
---

{items.length === 0 ? (
  <p class="py-10 text-center text-sm text-slate-500">Belum ada skor butir pertanyaan.</p>
) : (
  <div class="space-y-6">
    <div class="overflow-x-auto">
      <svg
        viewBox={`0 0 ${plotWidth} ${plotHeight}`}
        width="100%"
        role="img"
        aria-label={`Tren skor tiap butir pertanyaan (skala ${min.toFixed(0)} sampai ${max.toFixed(0)})`}
        preserveAspectRatio="xMidYMid meet"
      >
        <defs>
          <linearGradient id="itemTrendArea" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#014fcf" stop-opacity="0.10" />
            <stop offset="100%" stop-color="#014fcf" stop-opacity="0" />
          </linearGradient>
        </defs>

        <!-- kisi skala -->
        {ticks.map((tick) => (
          <g>
            <line
              x1={plotLeft}
              y1={yOf(tick).toFixed(1)}
              x2={plotRight}
              y2={yOf(tick).toFixed(1)}
              stroke={tick === min ? '#cbd5e1' : '#eef2f7'}
              stroke-width="1"
            />
            <text x={plotLeft - 8} y={yOf(tick) + 3.5} text-anchor="end" class="fill-slate-400" style="font-size:9.5px;font-weight:600">
              {tick % 1 === 0 ? tick.toFixed(0) : tick.toFixed(1)}
            </text>
          </g>
        ))}

        <!-- pemisah tahap -->
        {stageAnchors
          .filter((anchor) => anchor.startsStage && anchor.index > 0)
          .map((anchor) => (
            <g>
              <line
                x1={(xOf(anchor.index) - columnWidth / 2).toFixed(1)}
                y1={padTop}
                x2={(xOf(anchor.index) - columnWidth / 2).toFixed(1)}
                y2={plotHeight - 24}
                stroke="#e2e8f0"
                stroke-width="1"
                stroke-dasharray="4 4"
              />
              <rect
                x={(xOf(anchor.index) - columnWidth / 2).toFixed(1)}
                y={groupDividerY.toFixed(1)}
                width={columnWidth}
                height={2}
                fill="transparent"
              />
            </g>
          ))}

        <!-- garis tren -->
        {points.length > 1 && (
          <path d={linePath} fill="none" stroke="#0f172a" stroke-width="2.25" stroke-linejoin="round" stroke-linecap="round" />
        )}

        <!-- titik + nilai -->
        {points.map((item, index) => {
          const value = item.score as number;
          const below = value < baseline;
          return (
            <g>
              <circle
                cx={xOf(index).toFixed(1)}
                cy={yOf(value).toFixed(1)}
                r="5"
                fill={below ? '#e11d48' : '#ffbc00'}
                stroke="#0f172a"
                stroke-width="2"
              >
                <title>{item.label}: {formatScoreLocal(item.score)}</title>
              </circle>
              <text
                x={xOf(index).toFixed(1)}
                y={(yOf(value) - 12).toFixed(1)}
                text-anchor="middle"
                class={below ? 'fill-rose-600' : 'fill-slate-900'}
                style="font-size:10.5px;font-weight:800"
              >
                {formatScoreLocal(item.score)}
              </text>
            </g>
          );
        })}

        <!-- garis penghubung titik ke label -->
        {points.map((item, index) => (
          <line
            x1={xOf(index).toFixed(1)}
            y1={(yOf(item.score as number) + 8).toFixed(1)}
            x2={xOf(index).toFixed(1)}
            y2={axisY - 7}
            stroke="#cbd5e1"
            stroke-width="1"
            stroke-dasharray="3 3"
          />
        ))}

        <!-- garis sumbu X -->
        <line
          x1={labelWidth + 6}
          y1={axisY}
          x2={plotRight}
          y2={axisY}
          stroke="#cbd5e1"
          stroke-width="1"
        />

        <!-- label pertanyaan -->
        {points.map((item, index) => (
          <g>
            {wrapLabel(item.label).map((line, lineIndex) => (
              <text
                x={xOf(index).toFixed(1)}
                y={(axisY + axisLabelGap + lineIndex * labelLineHeight).toFixed(1)}
                text-anchor="middle"
                class="fill-slate-600"
                style="font-size:10px;font-weight:700"
              >
                {line}
              </text>
            ))}
          </g>
        ))}

        <!-- pembatas pergantian tahap layanan -->
        <line
          x1={labelWidth + 6}
          y1={groupDividerY.toFixed(1)}
          x2={plotRight}
          y2={groupDividerY.toFixed(1)}
          stroke="#e2e8f0"
          stroke-width="1"
          stroke-dasharray="4 4"
        />

        <!-- label tahap layanan dengan pemisah vertikal -->
        {stageAnchors
          .filter((anchor) => anchor.startsStage)
          .map((anchor) => (
            <g>
              <line
                x1={(xOf(anchor.index) - columnWidth / 2).toFixed(1)}
                y1={axisY}
                x2={(xOf(anchor.index) - columnWidth / 2).toFixed(1)}
                y2={(groupDividerY + 4).toFixed(1)}
                stroke="#cbd5e1"
                stroke-width="1"
              />
              <text
                x={xOf(anchor.index).toFixed(1)}
                y={groupLabelY.toFixed(1)}
                text-anchor="middle"
                class="fill-brand-blue/80"
                style="font-size:9px;font-weight:800;letter-spacing:0.05em"
              >
                {(stages.find((stage) => stage.key === anchor.item.stageKey)?.shortLabel ?? '').toUpperCase()}
              </text>
            </g>
          ))}
      </svg>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      <div class="rounded-lg bg-rose-50/70 px-4 py-3">
        <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-rose-600">Lowest Points</p>
        <p class="mt-1.5 text-[12px] font-semibold leading-relaxed text-slate-700">
          {lowPoints.map((item, index) => `${index > 0 ? ' · ' : ''}${item.label} (${formatScoreLocal(item.score)})`).join('') || '–'}
        </p>
      </div>
      <div class="rounded-lg bg-emerald-50/70 px-4 py-3">
        <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-emerald-700">Highest Points</p>
        <p class="mt-1.5 text-[12px] font-semibold leading-relaxed text-slate-700">
          {highPoints.map((item, index) => `${index > 0 ? ' · ' : ''}${item.label} (${formatScoreLocal(item.score)})`).join('') || '–'}
        </p>
      </div>
    </div>
  </div>
)}
