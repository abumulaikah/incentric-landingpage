---
/** Distribusi jumlah jawaban per titik skala, diwarnai per kategori NPS. */
interface Point {
  value: number;
  count: number;
  category: string | null;
}

interface Props {
  points: Point[];
  scale: '1-5' | '0-10';
}

const { points, scale } = Astro.props;
const maxCount = Math.max(...points.map((point) => point.count), 1);
const colorOf = (category: string | null) => {
  if (category === 'promoter') return '#014fcf';
  if (category === 'passive') return '#ffbc00';
  if (category === 'detractor') return '#e11d48';
  return '#94a3b8';
};
---

<div>
  <div class="flex h-40 items-end gap-1.5 sm:gap-2">
    {points.map((point) => {
      const heightPct = (point.count / maxCount) * 100;
      return (
        <div class="flex h-full flex-1 flex-col items-center justify-end gap-1">
          <span class="text-[11px] font-bold tabular-nums text-slate-600">{point.count > 0 ? point.count : ''}</span>
          <div
            class="w-full rounded-t-md transition-all"
            style={`height:${Math.max(point.count > 0 ? 6 : 0, heightPct)}%;background:${colorOf(point.category)};opacity:${point.count > 0 ? 0.9 : 0}`}
            title={`Skor ${point.value}: ${point.count} respons`}
          ></div>
        </div>
      );
    })}
  </div>
  <div class="mt-2 flex gap-1.5 border-t border-slate-200 pt-2 sm:gap-2">
    {points.map((point) => (
      <span class="flex-1 text-center text-[11px] font-semibold tabular-nums text-slate-500">{point.value}</span>
    ))}
  </div>
  <p class="mt-3 text-center text-[11px] font-medium text-slate-500">
    Skor rekomendasi ({scale === '1-5' ? 'skala 1–5' : 'skala 0–10'})
  </p>
</div>
