---
/** Bar chart horizontal dengan label nilai di ujung bar. */
interface Bar {
  label: string;
  value: number | null;
  note?: string;
  highlight?: boolean;
}

interface Props {
  bars: Bar[];
  max: number;
  min?: number;
  color?: string;
  valueFormat?: 'score' | 'correlation';
  emptyMessage?: string;
}

const {
  bars,
  max,
  min = 0,
  color = '#014fcf',
  valueFormat = 'score',
  emptyMessage = 'Belum ada data.',
} = Astro.props;

const decimals = valueFormat === 'correlation' ? 3 : 2;
const format = (value: number | null) => (value === null ? '–' : value.toFixed(decimals));
---

{bars.length === 0 ? (
  <p class="py-8 text-center text-sm text-slate-500">{emptyMessage}</p>
) : (
  <div class="space-y-3.5">
    {bars.map((bar) => {
      const pct = bar.value === null ? 0 : Math.max(0, Math.min(100, ((bar.value - min) / (max - min)) * 100));
      return (
        <div>
          <div class="mb-1.5 flex items-baseline justify-between gap-3">
            <span class="text-[13px] font-semibold leading-tight text-slate-700">{bar.label}</span>
            <span class="shrink-0 text-sm font-extrabold tabular-nums" style={bar.highlight ? `color:${color}` : undefined}>
              {format(bar.value)}
            </span>
          </div>
          <div class="h-2.5 w-full overflow-hidden rounded-full bg-slate-100">
            <div
              class="h-full rounded-full transition-all"
              style={`width:${pct}%;background:${bar.highlight ? color : color};opacity:${bar.highlight ? 1 : 0.72}`}
            ></div>
          </div>
          {bar.note && <p class="mt-1 text-[11px] text-slate-500">{bar.note}</p>}
        </div>
      );
    })}
  </div>
)}
