---
/**
 * Header mengikuti incentric.co.id: pill melayang dengan glass effect
 * (backdrop blur) dan logo Incentric.
 */
interface Props {
  /** light = latar terang (logo biru), dark = latar gelap (logo putih). */
  tone?: 'light' | 'dark';
  /** Tujuan klik logo. */
  homeHref?: string;
  clientName?: string;
  showAdmin?: boolean;
  showSignOut?: boolean;
  showExport?: boolean;
  exportHref?: string;
  summaryHref?: string;
  action?: { label: string; href: string; variant?: 'yellow' | 'outline' };
  links?: { label: string; href: string }[];
}

const {
  tone = 'light',
  homeHref = '/',
  clientName,
  showAdmin = false,
  showSignOut = false,
  showExport = false,
  exportHref = '#',
  summaryHref = '#',
  action,
  links = [],
} = Astro.props;

const isDark = tone === 'dark';
const logoSrc = isDark ? '/brand/incentric-logo-white.png' : '/brand/incentric-logo-blue.png';
---

<header class="no-print pointer-events-none fixed inset-x-0 top-4 z-50 flex justify-center px-4 sm:top-6">
  <div
    class:list={[
      'pointer-events-auto flex h-14 w-full max-w-[1240px] items-center justify-between gap-3 rounded-full border px-4 shadow-[0_8px_32px_rgba(0,0,0,0.10)] backdrop-blur-3xl transition-colors duration-500 sm:h-16 sm:px-6',
      isDark ? 'border-white/10 bg-slate-950/40 text-white' : 'border-black/5 bg-white/40 text-slate-900',
    ]}
  >
    <div class="flex min-w-0 items-center gap-3">
      <a href={homeHref} class="flex shrink-0 items-center transition-opacity hover:opacity-80" aria-label="Incentric">
        <img src={logoSrc} alt="Incentric" class="h-6 w-auto max-w-[132px] object-contain sm:h-7 sm:max-w-[150px] md:h-8 md:max-w-[170px]" />
      </a>
      {clientName && (
        <>
          <span class:list={['hidden h-6 w-px sm:block', isDark ? 'bg-white/20' : 'bg-slate-900/15']}></span>
          <span class="hidden truncate text-[11px] font-bold uppercase tracking-[0.16em] opacity-70 sm:block">
            {clientName}
          </span>
        </>
      )}
    </div>

    <div class="flex shrink-0 items-center gap-2">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'hidden rounded-full px-3 py-2 text-xs font-bold transition hover:opacity-70 sm:inline-block',
            isDark ? 'text-white' : 'text-slate-900',
          ]}
        >
          {link.label}
        </a>
      ))}

      {showExport && (
        <a
          href={exportHref}
          class:list={[
            'inline-flex min-h-10 items-center justify-center rounded-full px-4 text-xs font-bold uppercase tracking-[0.08em] transition',
            isDark ? 'bg-white text-slate-900 hover:bg-brand-yellow' : 'bg-slate-900 text-white hover:bg-brand-blue',
          ]}
        >
          Export CSV
        </a>
      )}

      {summaryHref !== '#' && (
        <a
          href={summaryHref}
          class:list={[
            'hidden min-h-10 items-center justify-center rounded-full border px-4 text-xs font-bold uppercase tracking-[0.08em] transition sm:inline-flex',
            isDark ? 'border-white/25 text-white hover:border-brand-yellow hover:text-brand-yellow' : 'border-slate-900/20 text-slate-900 hover:border-brand-blue hover:text-brand-blue',
          ]}
        >
          Summary
        </a>
      )}

      {showAdmin && (
        <a
          href="/admin"
          class:list={[
            'hidden min-h-10 items-center justify-center rounded-full border px-4 text-xs font-bold uppercase tracking-[0.08em] transition sm:inline-flex',
            isDark ? 'border-white/25 text-white hover:border-brand-yellow hover:text-brand-yellow' : 'border-slate-900/20 text-slate-900 hover:border-brand-blue hover:text-brand-blue',
          ]}
        >
          Admin
        </a>
      )}

      {action && (
        <a
          href={action.href}
          class:list={[
            'inline-flex min-h-10 items-center justify-center rounded-full px-4 text-xs font-bold uppercase tracking-[0.08em] transition',
            action.variant === 'outline'
              ? isDark
                ? 'border border-white/25 text-white hover:border-brand-yellow hover:text-brand-yellow'
                : 'border border-slate-900/20 text-slate-900 hover:border-brand-blue hover:text-brand-blue'
              : 'bg-brand-yellow text-slate-950 hover:bg-yellow-300',
          ]}
        >
          {action.label}
        </a>
      )}

      {showSignOut && (
        <form method="POST" action="/api/logout" class="inline">
          <button
            type="submit"
            class:list={[
              'inline-flex min-h-10 items-center justify-center rounded-full border px-4 text-xs font-bold uppercase tracking-[0.08em] transition',
              isDark ? 'border-white/25 text-white hover:border-brand-yellow hover:text-brand-yellow' : 'border-slate-900/20 text-slate-900 hover:border-brand-blue hover:text-brand-blue',
            ]}
          >
            Sign out
          </button>
        </form>
      )}
    </div>
  </div>
</header>
