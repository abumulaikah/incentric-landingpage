---
import { WHATSAPP_URL } from '../lib/contact';
import { BOOK_OFFER, RECENT_BOOK_PURCHASES, BOOK_TESTIMONIALS } from '../lib/book-offer';
import { BOOK_PREVIEW } from '../lib/book-preview';
import logo from '../assets/logos/incentric-logo-blue.png';
import { Image } from 'astro:assets';
import '../styles/book-landing.css';

const money = (value: number) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(value).replace(/\s/g, '');
const deadline = BOOK_OFFER.promotionEndsAt ? Date.parse(BOOK_OFFER.promotionEndsAt) : NaN;
const hasDeadline = Number.isFinite(deadline);
const active = !hasDeadline || deadline > Date.now();
const price = active ? BOOK_OFFER.offerPrice : BOOK_OFFER.regularPrice;
const orderMessage = (value: number) => `Halo Incentric, saya mau pesan buku Seni Merawat Pelanggan karya Ronald Satria dengan harga ${money(value)}. Mohon info format buku, ketersediaan, total biaya, dan cara pembayarannya.`;
const orderUrl = `${WHATSAPP_URL}&text=${encodeURIComponent(orderMessage(price))}`;
const chapters = [
  { number: '01', page: '1', title: 'Makna loyalitas pelanggan di era modern', text: 'Perubahan perilaku pelanggan dan alasan mereka tetap memilih sebuah bisnis.' },
  { number: '02', page: '16', title: 'Memahami pelanggan', text: 'Persona, mendengar aktif, data, dan peta perjalanan pelanggan.' },
  { number: '03', page: '29', title: 'Komunikasi yang menyentuh hati', text: 'Pilihan bahasa, gaya komunikasi, kanal digital, konflik, dan keluhan.' },
  { number: '04', page: '66', title: 'Pengalaman pelanggan sebagai investasi emosional', text: 'Titik interaksi penting, perhatian kecil, dan konsistensi layanan.' },
  { number: '05', page: '83', title: 'Membangun sistem pelayanan yang andal', text: 'Struktur tim, SOP, pelatihan, budaya layanan, dan teknologi pendukung.' },
  { number: '06', page: '107', title: 'Seni memberi nilai tambah', text: 'Program loyalitas, edukasi pelanggan, komunitas, serta nilai emosional dan sosial.' },
  { number: '07', page: '127', title: 'Inovasi dalam merawat pelanggan', text: 'Perbaikan proses, budaya internal, teknologi, dan pelayanan proaktif.' },
  { number: '08', page: '155', title: 'Menciptakan kenangan', text: 'Emosi, momen berkesan, konsistensi, dan kejutan positif.' },
  { number: '09', page: '180', title: 'Peran pemimpin dalam merawat pelanggan', text: 'Teladan, coaching, pembentukan kebiasaan, dan kewenangan tim di garis depan.' },
  { number: '10', page: '194', title: 'Dari dalam untuk tumbuh', text: 'Service-Profit Chain: layanan internal, kepuasan karyawan, dan pengalaman pelanggan.' },
];
const topics = [
  { title: 'Mendengar keluhan sampai jelas masalahnya', text: 'Mendengar aktif, memahami perasaan pelanggan, dan memakai masukan mereka untuk memeriksa layanan.', chapter: 'Bab 2 · mulai halaman 16' },
  { title: 'Menjawab pelanggan yang sedang kecewa', text: 'Memilih bahasa, menyesuaikan cara berkomunikasi, dan menangani konflik tanpa bersikap defensif.', chapter: 'Bab 3 · mulai halaman 29' },
  { title: 'Memberi tim pegangan saat melayani', text: 'Menyusun SOP yang menjaga konsistensi sekaligus memberi ruang untuk menangani situasi pelanggan.', chapter: 'Bab 5 · mulai halaman 83' },
  { title: 'Melatih kebiasaan layanan di tempat kerja', text: 'Memberi contoh, melakukan coaching, dan membantu tim mengambil keputusan sesuai kewenangannya.', chapter: 'Bab 9 · mulai halaman 180' },
];
const situations = [
  { id: 'keluhan', label: 'Pesanan terlambat', chapter: 'Contoh penerapan Bab 3', before: '“Itu sudah sesuai prosedur kami.”', after: '“Pesanan Anda belum sampai, ya. Saya cek posisinya sekarang dan kabari Anda paling lambat pukul 15.00.”', text: 'Pelanggan mendapat tindakan dan waktu yang jelas. Pilihan kata juga menunjukkan bahwa keluhannya didengar.' },
  { id: 'tim', label: 'Staf menunggu pemilik', chapter: 'Contoh penerapan Bab 5 dan 9', before: '“Kalau ada masalah, tunggu pemiliknya saja.”', after: '“Untuk kasus seperti ini, tim boleh menawarkan penggantian. Kita evaluasi penanganannya saat briefing.”', text: 'Batas keputusan ditentukan sejak awal. Tim bisa membantu pelanggan, lalu pemimpin mengecek cara penanganannya.' },
  { id: 'kembali', label: 'Pelanggan tidak komplain', chapter: 'Contoh penerapan Bab 2 dan 7', before: '“Tidak ada komplain. Berarti semuanya beres.”', after: '“Setelah pemakaian pertama, ada bagian yang menyulitkan? Masukan Anda akan kami pakai untuk memperbaiki layanan.”', text: 'Percakapan dibuka sebelum pelanggan mengeluh. Masukan yang masuk perlu dicatat dan ditindaklanjuti.' },
];
const validPurchases = RECENT_BOOK_PURCHASES.filter(p => p.name.trim() && Number.isFinite(Date.parse(p.purchasedAt)) && Date.parse(p.purchasedAt) <= Date.now());
const reviews = BOOK_PREVIEW.enabled ? BOOK_PREVIEW.reviews : BOOK_TESTIMONIALS;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Seni Merawat Pelanggan — Ronald Satria | Incentric</title>
    <meta name="description" content="Kenapa pelanggan hanya beli sekali? Baca cara memahami keluhan, menjawab pelanggan yang kecewa, dan menyiapkan tim layanan dalam buku Seni Merawat Pelanggan karya Ronald Satria." />
    <link rel="canonical" href={BOOK_OFFER.canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content="Kenapa pelanggan hanya beli sekali? | Seni Merawat Pelanggan" />
    <meta property="og:description" content="Buku Ronald Satria tentang memahami pelanggan, menangani keluhan, dan menyiapkan tim layanan. Pesan melalui WhatsApp Incentric." />
    <meta property="og:url" content={BOOK_OFFER.canonical} />
    <meta property="og:image" content="https://incentric.co.id/media/seni-merawat-pelanggan-cover.jpeg" />
    <meta name="theme-color" content="#ff771c" />
  </head>
  <body>
    <a class="skip-link" href="#utama">Lewati ke isi halaman</a>
    <aside class="demo-banner" data-demo-only hidden={!BOOK_PREVIEW.enabled}>Pratinjau untuk review: ulasan, hitung mundur, dan aktivitas pesanan di halaman ini adalah simulasi, bukan data pelanggan.</aside>
    <header class="site-header container">
      <a href="/" class="brand" aria-label="Beranda Incentric"><Image src={logo} alt="Incentric" width={136} height={39} format="webp" densities={[1, 2]} /></a>
      <nav aria-label="Navigasi buku"><a href="#isi-buku">Isi buku</a><a href="#penulis">Penulis</a><a class="nav-order" href={orderUrl} data-order>Pesan buku</a></nav>
    </header>
    <main id="utama">
      <div class="hero-surface">
        <section class="hero container" aria-labelledby="hero-title">
          <figure class="hero-visual">
            <div class="book-stage"><div class="cover-frame"><img src="/media/seni-merawat-pelanggan-cover.jpeg" alt="Cover buku Seni Merawat Pelanggan karya Ronald Satria" width="400" height="588" fetchpriority="high" /></div></div>
            <figcaption><strong>Seni Merawat Pelanggan</strong><span>Ronald Satria · 10 bab utama dan penutup</span></figcaption>
          </figure>
          <div class="hero-main">
            <div class="product-heading">
              <p>Buku untuk pemilik bisnis &amp; tim layanan</p>
            </div>
            <h1 id="hero-title">Kenapa pelanggan<br class="desktop-break" /> hanya beli sekali?</h1>
            <p class="hero-description">Sudah rajin promosi, tapi pelanggan lama tidak pesan lagi? Ada yang hanya datang saat diskon. Ada juga yang berhenti setelah komplain.</p>
            <p class="hero-description hero-book-description">Dalam <strong>Seni Merawat Pelanggan</strong>, Ronald Satria membahas cara menanggapi keluhan dan menyiapkan tim agar kualitas pelayanan tidak bergantung pada Anda seorang.</p>
            <div class="hero-price"><del data-old-price hidden={!active}>{money(BOOK_OFFER.regularPrice)}</del><strong data-price>{money(price)}</strong><span data-savings hidden={!active}>Hemat Rp100.000</span></div>
            <div class="hero-actions"><a class="button order-button" href={orderUrl} data-order>Pesan buku lewat WhatsApp</a><a class="sample-link" href="#cuplikan">Baca contoh isi</a></div>
            <p class="order-note">Format buku dan total biaya dikonfirmasi lewat chat.</p>
            <div class="demo-countdown" data-demo-only hidden={!BOOK_PREVIEW.enabled}><span>Simulasi hitung mundur · bukan batas promo</span><p><b data-demo-hours>23</b><small>jam</small><b data-demo-minutes>17</b><small>menit</small><b data-demo-seconds>42</b><small>detik</small></p></div>
          </div>
        </section>
        <div class="hero-footnote container"><span>Di dalam buku</span><p>Menangani keluhan</p><p>Menyiapkan SOP layanan</p><p>Melatih tim saat bekerja</p></div>
      </div>

      <section class="pain-section container section-pad" aria-labelledby="pain-title">
        <div class="section-intro">
          <h2 id="pain-title">Pelanggan yang berhenti membeli tidak selalu memberi tahu alasannya.</h2>
          <p>Keluhan yang masuk bisa Anda tangani. Yang lebih sulit terlihat adalah pengalaman yang membuat pelanggan diam-diam memilih tempat lain.</p>
          <p>Itulah sebabnya buku ini membahas apa yang terjadi sepanjang pelanggan berinteraksi dengan bisnis Anda, termasuk cara tim bekerja di belakangnya.</p>
        </div>
        <ul class="pain-list">
          <li><h3>Pelanggan hanya datang saat diskon.</h3><p>Setelah membeli, mereka belum menemukan alasan untuk memilih Anda lagi.</p></li>
          <li><h3>Keluhan ditangani, pelanggan tetap kecewa.</h3><p>Masalahnya selesai, tetapi cara menanggapinya membuat mereka merasa dipersulit.</p></li>
          <li><h3>Layanan berubah saat staf berganti.</h3><p>Pelanggan mendapat pengalaman berbeda, tergantung siapa yang sedang bertugas.</p></li>
        </ul>
      </section>

      <section id="cuplikan" class="preview-section section-pad" aria-labelledby="preview-title">
        <div class="container">
          <div class="preview-heading"><h2 id="preview-title">Lihat contoh pembahasannya.</h2><p>Di Bab 3, Ronald Satria membahas pilihan bahasa saat pelanggan menghadapi masalah.</p></div>
          <figure class="book-excerpt"><blockquote>“Pelanggan ingin merasa dimengerti sebelum masalah mereka diselesaikan.”</blockquote><figcaption>Seni Merawat Pelanggan · Bab 3, halaman 30</figcaption></figure>
          <p class="scenario-intro">Seperti apa penerapannya? Pilih salah satu situasi berikut.</p>
          <div class="scenario-tabs" role="tablist" aria-label="Contoh situasi layanan">
            {situations.map((s, i) => <button type="button" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={s.id}>{s.label}</button>)}
          </div>
          {situations.map((s, i) => <div class="scenario-panel" id={`panel-${s.id}`} role="tabpanel" aria-labelledby={`tab-${s.id}`} tabindex="0" hidden={i !== 0}>
            <div class="response-before"><h3>Respons awal</h3><p>{s.before}</p></div>
            <div class="response-after"><h3>Respons yang lebih membantu</h3><p>{s.after}</p></div>
            <div class="scenario-explanation"><p>{s.text}</p><small>{s.chapter}. Respons disusun sebagai ilustrasi materi buku.</small></div>
          </div>)}
        </div>
      </section>

      <section id="isi-buku" class="contents-section container section-pad" aria-labelledby="contents-title">
        <div class="section-intro contents-intro"><h2 id="contents-title">Yang dibahas di buku ini</h2><p>Empat pembahasan berikut dekat dengan pekerjaan sehari-hari pemilik bisnis dan tim layanan.</p></div>
        <div class="topics">{topics.map(topic => <article><h3>{topic.title}</h3><p>{topic.text}</p><span>{topic.chapter}</span></article>)}</div>
        <details class="contents-disclosure">
          <summary>Lihat daftar isi lengkap <span>10 bab utama dan penutup</span></summary>
          <ol class="chapters">{chapters.map(c => <li class="chapter"><div class="chapter-heading"><h3>{c.title}</h3><span>Halaman {c.page}</span></div><p>{c.text}</p></li>)}</ol>
          <p class="contents-end">Bab 11: Penutup · halaman 219</p>
        </details>
      </section>

      <section class="demo-testimonials container section-pad" hidden={reviews.length === 0} aria-labelledby="reviews-title">
        <div class="reviews-heading"><div>{BOOK_PREVIEW.enabled && <span class="demo-label">Simulasi testimoni</span>}<h2 id="reviews-title">{BOOK_PREVIEW.enabled ? 'Contoh tampilan ulasan pembaca' : 'Ulasan pembaca'}</h2></div>{BOOK_PREVIEW.enabled && <p>Teks dan nama berikut adalah rekaan untuk pratinjau desain. Ganti dengan ulasan asli sebelum digunakan untuk penjualan.</p>}</div>
        <div class="review-grid">{reviews.map(review => <figure class="review-card"><span class="review-mark" aria-hidden="true">“</span><blockquote>{review.text}</blockquote><figcaption><strong>{review.name}</strong><span>{review.role}{BOOK_PREVIEW.enabled ? ' · bukan ulasan asli' : ''}</span></figcaption></figure>)}</div>
      </section>

      <section id="penulis" class="author-section section-pad" aria-labelledby="author-title">
        <div class="container author-grid">
          <div><h2 id="author-title">Tentang Ronald Satria</h2><p>Ronald Satria menulis buku ini dari referensi, contoh keberhasilan, dan pengalamannya mendampingi organisasi dalam pengembangan pelayanan pelanggan dan budaya layanan.</p><p>Pembahasannya juga mencakup peran pemimpin: memberi contoh, melatih kebiasaan kerja, dan menetapkan kebijakan yang membantu tim melayani pelanggan.</p></div>
          <aside class="audience"><h3>Untuk siapa buku ini?</h3><ul><li>Pemilik bisnis yang ingin memeriksa layanan setelah transaksi.</li><li>Pemimpin tim yang perlu menyamakan cara staf melayani.</li><li>Praktisi customer experience dan orang yang sehari-hari menghadapi pelanggan.</li></ul></aside>
        </div>
      </section>

      <section id="pesan" class="order-section container section-pad" aria-labelledby="order-title">
        <div class="order-heading"><h2 id="order-title">Pemesanan buku</h2><p>Pesanan dilayani oleh tim Incentric melalui WhatsApp.</p></div>
        <div class="order-grid">
          <div class="faqs">
            <details open><summary>Bagaimana cara memesan?</summary><p>Tekan tombol pesan, lalu kirim pesan yang sudah terisi di WhatsApp. Tim Incentric akan membantu mengonfirmasi pesanan dan memberi arahan pembayaran.</p></details>
            <details><summary>Bukunya cetak atau digital?</summary><p>Konfirmasikan format yang tersedia kepada tim Incentric sebelum membayar. Jika ada biaya pengiriman atau biaya lain, totalnya perlu dikonfirmasi dalam chat.</p></details>
            <details><summary>Apakah cocok untuk bisnis kecil?</summary><p>Pembahasan komunikasi, keluhan, SOP, dan kebiasaan tim bisa Anda pilih sesuai kondisi bisnis. Anda tidak harus menerapkan seluruh pembahasan sekaligus.</p></details>
            <details><summary>Apakah isinya hanya teori?</summary><p>Buku memadukan referensi dengan contoh situasi layanan dan pembahasan penerapan, seperti mendengar aktif, menangani komplain, memetakan perjalanan pelanggan, dan melatih tim saat bekerja.</p></details>
          </div>
          <div class="offer-card">
            <div class="order-product"><img src="/media/seni-merawat-pelanggan-cover.jpeg" alt="Seni Merawat Pelanggan" width="76" height="112" loading="lazy" /><div><h3>Seni Merawat Pelanggan</h3><p>Ronald Satria</p><span>10 bab utama dan penutup</span></div></div>
            <div class="offer-price-row"><del data-old-price hidden={!active}>{money(BOOK_OFFER.regularPrice)}</del><strong data-price>{money(price)}</strong></div>
            <p class="saving-label" data-savings hidden={!active}>Hemat Rp100.000 dari harga Rp199.000.</p>
            <div class="real-countdown" data-countdown hidden={!hasDeadline || !active}>
              <p>Penawaran berakhir pada <time datetime={BOOK_OFFER.promotionEndsAt || undefined}>{hasDeadline ? new Intl.DateTimeFormat('id-ID', {dateStyle: 'long', timeStyle: 'short', timeZone: 'Asia/Jakarta'}).format(deadline) + ' WIB' : ''}</time></p>
              <div class="countdown-digits"><span><b data-hours>00</b><small>jam</small></span><span><b data-minutes>00</b><small>menit</small></span><span><b data-seconds>00</b><small>detik</small></span></div>
            </div>
            <a class="button order-button offer-button" href={orderUrl} data-order>Pesan buku lewat WhatsApp</a>
            <p class="order-note">Format, ketersediaan, dan total biaya dikonfirmasi sebelum pembayaran.</p>
          </div>
        </div>
      </section>
    </main>
    <footer class="footer container"><a href="/">Incentric</a><a href={orderUrl} data-order>Hubungi tim Incentric</a><span>© {new Date().getFullYear()} Incentric</span></footer>
    <aside class="mobile-order" aria-label="Pesan buku"><div><small>Seni Merawat Pelanggan</small><strong data-price>{money(price)}</strong></div><a class="button order-button" href={orderUrl} data-order>Pesan buku</a></aside>
    <aside class="purchase-notification demo-purchase" data-demo-purchase hidden aria-label="Simulasi notifikasi pembelian"><img src="/media/seni-merawat-pelanggan-cover.jpeg" alt="" width="38" height="56" /><div><span class="demo-label">Simulasi pesanan</span><strong data-demo-name>Irwan · nama contoh</strong><p>Memesan Seni Merawat Pelanggan</p><small data-demo-age>30 menit lalu · data rekaan</small></div><button type="button" data-close-demo aria-label="Tutup simulasi pesanan">×</button></aside>
    {validPurchases.length > 0 && <aside class="purchase-notification" data-purchase-notification hidden aria-label="Pesanan terbaru"><div><strong data-purchase-name></strong><p>Memesan Seni Merawat Pelanggan</p><small data-purchase-time></small></div><button type="button" data-close-purchase aria-label="Tutup notifikasi pesanan">×</button></aside>}
    <script is:inline define:vars={{ bookOffer: BOOK_OFFER, whatsappBase: WHATSAPP_URL, recentBookOrders: validPurchases, bookPreview: BOOK_PREVIEW }}>
      const tabs = [...document.querySelectorAll('[data-tab]')];
      function selectTab(tab, focus = false) {
        tabs.forEach(button => { const selected = button === tab; button.setAttribute('aria-selected', String(selected)); button.tabIndex = selected ? 0 : -1; document.getElementById(`panel-${button.dataset.tab}`).hidden = !selected; });
        if (focus) tab.focus();
      }
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectTab(tab));
        tab.addEventListener('keydown', event => {
          let next = index;
          if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = tabs.length - 1;
          else return;
          event.preventDefault(); selectTab(tabs[next], true);
        });
      });
      const formatPrice = value => new Intl.NumberFormat('id-ID', {style: 'currency', currency: 'IDR', maximumFractionDigits: 0}).format(value).replace(/\s/g, '');
      const end = bookOffer.promotionEndsAt ? Date.parse(bookOffer.promotionEndsAt) : NaN;
      let priceState;
      function updateOffer() {
        const remaining = end - Date.now();
        const active = !Number.isFinite(end) || remaining > 0;
        document.querySelectorAll('[data-countdown]').forEach(node => node.hidden = !Number.isFinite(end) || !active);
        if (active && Number.isFinite(end)) {
          const total = Math.max(0, Math.floor(remaining / 1000));
          [['hours', Math.floor(total / 3600)], ['minutes', Math.floor(total % 3600 / 60)], ['seconds', total % 60]].forEach(([key, value]) => document.querySelectorAll(`[data-${key}]`).forEach(node => node.textContent = String(value).padStart(2, '0')));
        }
        if (priceState === active) return;
        priceState = active;
        const price = active ? bookOffer.offerPrice : bookOffer.regularPrice;
        document.querySelectorAll('[data-price]').forEach(node => node.textContent = formatPrice(price));
        document.querySelectorAll('[data-old-price], [data-savings]').forEach(node => node.hidden = !active);
        const message = `Halo Incentric, saya mau pesan buku Seni Merawat Pelanggan karya Ronald Satria dengan harga ${formatPrice(price)}. Mohon info format buku, ketersediaan, total biaya, dan cara pembayarannya.`;
        document.querySelectorAll('[data-order]').forEach(link => link.href = `${whatsappBase}&text=${encodeURIComponent(message)}`);
      }
      updateOffer();
      if (Number.isFinite(end)) setInterval(updateOffer, 1000);
      const demoMode = bookPreview.enabled;
      if (demoMode) {
        document.querySelectorAll('[data-demo-only]').forEach(node => node.hidden = false);
        // Persist an explicitly simulated deadline in this tab; refreshing does not reset it.
        const demoKey = 'incentric-book-demo-deadline-v1';
        let demoEnd;
        try {
          demoEnd = Number(sessionStorage.getItem(demoKey));
          if (!Number.isFinite(demoEnd) || demoEnd <= 0) { demoEnd = Date.now() + bookPreview.countdownSeconds * 1000; sessionStorage.setItem(demoKey, String(demoEnd)); }
        } catch { demoEnd = Date.now() + bookPreview.countdownSeconds * 1000; }
        const tickDemo = () => {
          const seconds = Math.max(0, Math.floor((demoEnd - Date.now()) / 1000));
          [['hours', Math.floor(seconds / 3600)], ['minutes', Math.floor(seconds % 3600 / 60)], ['seconds', seconds % 60]].forEach(([key, value]) => document.querySelector(`[data-demo-${key}]`).textContent = String(value).padStart(2, '0'));
        };
        tickDemo(); setInterval(tickDemo, 1000);
        const demoNotice = document.querySelector('[data-demo-purchase]');
        const examples = bookPreview.purchases;
        let exampleIndex = 0, demoDismissed = false;
        const showDemo = () => {
          if (demoDismissed || document.hidden || !examples.length) return;
          const example = examples[exampleIndex++ % examples.length];
          demoNotice.querySelector('[data-demo-name]').textContent = example.name;
          demoNotice.querySelector('[data-demo-age]').textContent = example.age;
          demoNotice.hidden = false;
          setTimeout(() => demoNotice.hidden = true, 7000);
        };
        demoNotice.querySelector('[data-close-demo]').addEventListener('click', () => { demoDismissed = true; demoNotice.hidden = true; });
        setTimeout(showDemo, 2500); setInterval(showDemo, 24000);
      }
      const notice = document.querySelector('[data-purchase-notification]');
      if (!demoMode && notice && recentBookOrders.length) {
        let purchaseIndex = 0, dismissed = false;
        const formatter = new Intl.RelativeTimeFormat('id-ID', {numeric: 'auto'});
        function showPurchase() {
          if (dismissed || document.hidden) return;
          const purchase = recentBookOrders[purchaseIndex++ % recentBookOrders.length];
          const age = Math.max(0, Math.floor((Date.now() - Date.parse(purchase.purchasedAt)) / 60000));
          notice.querySelector('[data-purchase-name]').textContent = purchase.name;
          notice.querySelector('[data-purchase-time]').textContent = age >= 1440 ? formatter.format(-Math.floor(age / 1440), 'day') : age >= 60 ? formatter.format(-Math.floor(age / 60), 'hour') : formatter.format(-age, 'minute');
          notice.hidden = false;
          setTimeout(() => { notice.hidden = true; }, 6500);
        }
        notice.querySelector('[data-close-purchase]').addEventListener('click', () => { dismissed = true; notice.hidden = true; });
        setTimeout(showPurchase, 14000);
        setInterval(showPurchase, 38000);
      }
    </script>
  </body>
</html>
