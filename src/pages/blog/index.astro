---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const getPostChips = (post: (typeof posts)[number]) =>
  [...post.data.tags, ...post.data.categories, post.data.author].filter(
    (value, index, values) => value && values.indexOf(value) === index,
  );
---

<BaseLayout title="Blog | Incentric CX" description="Ideas and insights from Incentric.">
  <main class="min-h-screen bg-slate-50 px-6 py-24 text-slate-900">
    <div class="mx-auto max-w-4xl">
      <a href="/" class="text-sm font-bold text-brand-blue hover:underline">Back to home</a>
      <div class="mt-8 border-b border-slate-200 pb-10">
        <h1 class="text-4xl font-bold tracking-tight md:text-6xl">Blog</h1>
        <p id="blog-description" class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600">
          Customer experience thinking, frameworks, and practical notes from Incentric.
        </p>
        <div id="active-filter" class="mt-6 hidden items-center gap-3">
          <span class="rounded-md bg-brand-blue px-3 py-1.5 text-sm font-bold text-white"></span>
          <a href="/blog/" class="text-sm font-bold text-brand-blue hover:underline">Clear filter</a>
        </div>
      </div>

      <div id="blog-list" class="mt-10 grid gap-6">
        {
          posts.map((post) => (
            <article
              class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm transition hover:border-brand-blue/30 hover:shadow-md"
              data-filter-values={getPostChips(post).join('|||')}
            >
              <p class="text-sm font-medium text-slate-500">
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
              <h2 class="mt-3 text-2xl font-bold">
                <a href={`/blog/${post.slug}/`} class="hover:text-brand-blue">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 leading-relaxed text-slate-600">{post.data.description}</p>
              {
                getPostChips(post).length > 0 && (
                  <div class="mt-5 flex flex-wrap gap-2">
                    {getPostChips(post)
                      .slice(0, 4)
                      .map((chip) => (
                        <a
                          href={`/blog/?filter=${encodeURIComponent(chip)}`}
                          class="rounded-md bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-700 transition hover:bg-brand-blue hover:text-white"
                        >
                          {chip}
                        </a>
                      ))}
                  </div>
                )
              }
            </article>
          ))
        }
      </div>

      <p id="empty-filter" class="mt-10 hidden rounded-lg border border-slate-200 bg-white p-6 text-slate-600">
        No posts found for this filter.
      </p>
    </div>
  </main>

  <script>
    const filter = new URLSearchParams(window.location.search).get('filter');
    const normalizedFilter = filter?.trim().toLowerCase();
    const posts = Array.from(document.querySelectorAll<HTMLElement>('[data-filter-values]'));
    const activeFilter = document.querySelector<HTMLElement>('#active-filter');
    const activeFilterLabel = activeFilter?.querySelector('span');
    const description = document.querySelector<HTMLElement>('#blog-description');
    const emptyFilter = document.querySelector<HTMLElement>('#empty-filter');

    if (normalizedFilter && activeFilter && activeFilterLabel && description && emptyFilter) {
      let visibleCount = 0;

      posts.forEach((post) => {
        const values = (post.dataset.filterValues ?? '')
          .split('|||')
          .map((value) => value.trim().toLowerCase());
        const isVisible = values.includes(normalizedFilter);

        post.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      activeFilterLabel.textContent = filter;
      activeFilter.classList.remove('hidden');
      activeFilter.classList.add('flex');
      description.textContent = `Showing ${visibleCount} post${visibleCount === 1 ? '' : 's'} filtered by "${filter}".`;
      emptyFilter.classList.toggle('hidden', visibleCount > 0);
      document.title = `${filter} | Blog | Incentric CX`;
    }
  </script>
</BaseLayout>
