---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Navbar } from '../../components/Navbar';
import { Footer } from '../../components/Footer';
import { WHATSAPP_URL } from '../../lib/contact';

const customerGroups = [
  {
    label: 'Promoters',
    score: '9-10',
    copy: 'Customer yang sangat puas dan dengan sukarela merekomendasikan bisnis Anda. Mereka adalah aset pertumbuhan terbesar.',
    color: 'bg-brand-blue text-white',
  },
  {
    label: 'Passives',
    score: '7-8',
    copy: 'Customer yang cukup puas, namun belum memiliki ikatan emosional yang kuat. Mereka rentan berpindah ke kompetitor.',
    color: 'bg-brand-yellow text-slate-950',
  },
  {
    label: 'Detractors',
    score: '0-6',
    copy: 'Customer yang kecewa dan berpotensi menyebarkan pengalaman negatif, baik langsung maupun melalui kanal digital.',
    color: 'bg-slate-950 text-white',
  },
];

const questions = [
  'Di mana letak titik gesekan yang membuat customer tidak kembali?',
  'Siapa customer terbaik Anda, dan mengapa mereka setia?',
  'Di mana investasi pengalaman customer akan memberikan dampak terbesar?',
];

const growthLevers = [
  {
    label: 'Stay Longer',
    title: 'Membuat customer bertahan lebih lama',
    copy: 'Customer yang merasa dipahami dan dihargai tidak perlu dibujuk dengan diskon. Mereka kembali karena pengalaman yang tidak ingin mereka tinggalkan.',
  },
  {
    label: 'Spend More',
    title: 'Mendorong customer bertransaksi lebih banyak',
    copy: 'Customer loyal memiliki sensitivitas harga yang lebih rendah dan kecenderungan lebih tinggi untuk mencoba produk atau layanan lain yang Anda tawarkan.',
  },
  {
    label: 'Recommend',
    title: 'Mengaktifkan promoters sebagai mesin pertumbuhan',
    copy: 'NPS membantu Anda memahami apa yang perlu dijaga agar lebih banyak customer bergerak dari sekadar puas menjadi bangga merekomendasikan bisnis Anda.',
  },
];

const services = [
  'Perancangan instrumen survei yang relevan dengan konteks bisnis dan industri Anda',
  'Pengumpulan data yang sistematis dengan metodologi yang tepat',
  'Analisis mendalam terhadap tren, pola, dan akar permasalahan di balik skor NPS',
  'Laporan insight strategis yang menghubungkan temuan data dengan prioritas bisnis',
  'Rekomendasi actionable sebagai landasan keputusan untuk meningkatkan loyalitas customer',
];
---

<BaseLayout
  title="Survei Net Promoter Score (NPS) | Incentric CX"
  description="Survei NPS by Incentric helps businesses measure customer loyalty, identify promoters, passives, and detractors, and turn customer feedback into growth strategy."
>
  <main id="top" class="min-h-screen overflow-hidden bg-[#e7eaee] text-slate-950">
    <Navbar theme="light" client:load />

    <section class="relative px-6 pb-16 pt-32 md:pt-40 lg:px-10">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[minmax(0,1.02fr)_minmax(390px,0.98fr)] lg:items-center">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.24em] text-brand-blue">Survei Net Promoter Score</p>
          <h1 class="mt-6 max-w-5xl text-5xl font-bold leading-[0.98] tracking-tight md:text-7xl lg:text-[5.6rem]">
            Customer banyak. Tapi apakah mereka loyal?
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-relaxed text-slate-600 md:text-xl">
            Transaksi bisa terlihat sehat, customer datang, produk terjual. Namun pertanyaan yang paling menentukan pertumbuhan sering belum terjawab: seberapa besar kemungkinan customer Anda merekomendasikan bisnis Anda?
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={WHATSAPP_URL} target="_blank" rel="noreferrer" class="inline-flex min-h-12 items-center justify-center rounded-full bg-slate-950 px-6 py-3 text-sm font-bold text-white transition hover:bg-brand-blue">
              Mari Bicara
            </a>
            <a href="#nps" class="inline-flex min-h-12 items-center justify-center rounded-full border border-slate-400 px-6 py-3 text-sm font-bold text-slate-950 transition hover:border-brand-blue hover:text-brand-blue">
              Apa Itu NPS?
            </a>
          </div>
        </div>

        <aside class="rounded-lg border border-slate-950 bg-white p-5 shadow-[0_24px_80px_rgba(15,23,42,0.18)]">
          <div class="rounded-lg bg-slate-950 p-6 text-white">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-yellow">The Loyalty Question</p>
            <p class="mt-4 text-3xl font-bold leading-tight">Seberapa mungkin Anda merekomendasikan bisnis ini kepada orang lain?</p>
            <div class="mt-8 grid grid-cols-11 gap-1">
              {Array.from({ length: 11 }, (_, index) => (
                <span class={`flex aspect-square items-center justify-center rounded-md text-xs font-black ${index <= 6 ? 'bg-white/10 text-white/70' : index <= 8 ? 'bg-brand-yellow text-slate-950' : 'bg-brand-blue text-white'}`}>
                  {index}
                </span>
              ))}
            </div>
          </div>
          <div class="grid gap-4 pt-5 sm:grid-cols-3">
            <div class="rounded-lg border border-slate-200 p-4">
              <p class="text-3xl font-black text-slate-950">0-6</p>
              <p class="mt-1 text-sm font-bold text-slate-500">Detractors</p>
            </div>
            <div class="rounded-lg border border-slate-200 p-4">
              <p class="text-3xl font-black text-brand-yellow">7-8</p>
              <p class="mt-1 text-sm font-bold text-slate-500">Passives</p>
            </div>
            <div class="rounded-lg border border-slate-200 p-4">
              <p class="text-3xl font-black text-brand-blue">9-10</p>
              <p class="mt-1 text-sm font-bold text-slate-500">Promoters</p>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section id="nps" class="border-y border-slate-300 bg-white px-6 py-16 lg:px-10 lg:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.24em] text-brand-blue">What NPS Measures</p>
            <h2 class="mt-5 text-4xl font-bold leading-tight tracking-tight md:text-6xl">
              NPS membaca kualitas hubungan, bukan hanya kepuasan.
            </h2>
          </div>
          <p class="max-w-2xl text-lg leading-relaxed text-slate-600 lg:justify-self-end">
            Net Promoter Score adalah metrik loyalitas customer yang digunakan perusahaan terkemuka di seluruh dunia untuk memahami kekuatan relasi antara customer dan bisnis.
          </p>
        </div>

        <div class="mt-12 grid gap-5 lg:grid-cols-3">
          {customerGroups.map((group) => (
            <article class="flex min-h-[320px] flex-col justify-between rounded-lg border border-slate-300 bg-[#e7eaee] p-6">
              <div class="flex items-start justify-between gap-5">
                <h3 class="text-3xl font-bold tracking-tight">{group.label}</h3>
                <span class={`rounded-md px-3 py-1.5 text-sm font-black ${group.color}`}>{group.score}</span>
              </div>
              <p class="mt-10 text-lg leading-relaxed text-slate-600">{group.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-slate-950 px-6 py-16 text-white lg:px-10 lg:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
        <div class="lg:sticky lg:top-28">
          <p class="text-sm font-bold uppercase tracking-[0.24em] text-brand-yellow">Why It Matters</p>
          <h2 class="mt-5 text-4xl font-bold leading-tight tracking-tight text-white md:text-6xl">
            Tanpa data, loyalitas sering hanya asumsi.
          </h2>
        </div>
        <div class="grid gap-4">
          {questions.map((question, index) => (
            <article class="grid gap-5 rounded-lg border border-white/10 bg-white/[0.045] p-6 md:grid-cols-[80px_1fr] md:items-center">
              <p class="text-4xl font-black text-brand-yellow">{String(index + 1).padStart(2, '0')}</p>
              <p class="text-2xl font-bold leading-tight text-white">{question}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-6 py-16 lg:px-10 lg:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-4xl">
          <p class="text-sm font-bold uppercase tracking-[0.24em] text-brand-blue">From NPS Data to Growth Strategy</p>
          <h2 class="mt-5 text-4xl font-bold leading-tight tracking-tight md:text-6xl">
            Data NPS menjadi fondasi strategi pertumbuhan.
          </h2>
        </div>

        <div class="mt-12 grid gap-5 lg:grid-cols-3">
          {growthLevers.map((lever) => (
            <article class="rounded-lg border border-slate-300 bg-white p-6">
              <p class="text-sm font-black uppercase tracking-[0.2em] text-brand-blue">{lever.label}</p>
              <h3 class="mt-5 text-2xl font-bold leading-tight tracking-tight">{lever.title}</h3>
              <p class="mt-5 leading-relaxed text-slate-600">{lever.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-slate-300 bg-white px-6 py-16 lg:px-10 lg:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.24em] text-brand-blue">What We Do</p>
          <h2 class="mt-5 text-4xl font-bold leading-tight tracking-tight md:text-6xl">
            Kami ubah feedback menjadi prioritas bisnis.
          </h2>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600">
            Layanan Survei NPS dari Incentric bukan sekadar mengumpulkan data. Kami merancang proses survei yang terstruktur dan mengolah hasilnya menjadi insight yang dapat langsung ditindaklanjuti.
          </p>
        </div>
        <div class="grid gap-3">
          {services.map((item, index) => (
            <article class="grid gap-4 rounded-lg border border-slate-300 bg-[#e7eaee] p-5 md:grid-cols-[56px_1fr] md:items-center">
              <span class="flex h-12 w-12 items-center justify-center rounded-md bg-slate-950 text-sm font-black text-brand-yellow">
                {String(index + 1).padStart(2, '0')}
              </span>
              <p class="text-lg font-bold leading-snug text-slate-950">{item}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-6 py-16 lg:px-10 lg:py-20">
      <div class="mx-auto grid max-w-7xl gap-8 rounded-lg bg-slate-950 p-8 text-white md:p-10 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.24em] text-brand-yellow">Start with the Truth</p>
          <h2 class="mt-5 max-w-4xl text-4xl font-bold leading-tight tracking-tight text-white md:text-6xl">
            Bisnis yang bertumbuh dimulai dari pemahaman yang benar.
          </h2>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/68">
            Survei NPS membantu Anda membuat keputusan strategis berdasarkan apa yang sesungguhnya dirasakan customer, bukan asumsi.
          </p>
        </div>
        <a href={WHATSAPP_URL} target="_blank" rel="noreferrer" class="inline-flex min-h-14 items-center justify-center rounded-full bg-brand-yellow px-8 py-4 text-sm font-black uppercase tracking-[0.12em] text-slate-950 transition hover:bg-yellow-300">
          Mari Bicara
        </a>
      </div>
    </section>

    <Footer client:load />
  </main>
</BaseLayout>
