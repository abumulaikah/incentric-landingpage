---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Navbar } from '../../components/Navbar';
import { Footer } from '../../components/Footer';
import { WHATSAPP_URL } from '../../lib/contact';

const dimensions = [
  {
    label: 'Basic Needs',
    question: 'Apakah karyawan punya kejelasan peran dan dukungan yang cukup untuk bekerja dengan baik?',
    note: 'Tanpa fondasi ini, program motivasi apa pun tidak akan bertahan lama.',
  },
  {
    label: 'Individual Contribution',
    question: 'Apakah setiap karyawan merasa kontribusinya dihargai dan sesuai dengan kekuatan mereka?',
    note: 'Inilah yang membedakan karyawan yang sekadar hadir dengan yang benar-benar berdedikasi.',
  },
  {
    label: 'Teamwork',
    question: 'Apakah ada rasa saling percaya dan kolaborasi yang sehat di dalam tim?',
    note: 'Lingkungan kerja yang positif adalah syarat agar tim bisa bekerja konsisten dan efektif.',
  },
  {
    label: 'Growth',
    question: 'Apakah karyawan melihat masa depan mereka di perusahaan Anda?',
    note: 'Ketika karyawan merasa bertumbuh bersama bisnis, loyalitas mereka ikut meningkat.',
  },
];

const process = [
  ['01', 'Design Survey', 'Pertanyaan disesuaikan dengan konteks tim, level organisasi, dan kebutuhan keputusan bisnis.'],
  ['02', 'Collect Voice', 'Karyawan mengisi survey secara praktis, sehingga suara tim terkumpul lebih jujur dan rapi.'],
  ['03', 'Read the Pattern', 'Data dibaca per dimensi, tim, dan prioritas intervensi yang paling berdampak.'],
  ['04', 'Action Plan', 'Anda mendapatkan rekomendasi langkah konkret untuk memperkuat engagement dan performa.'],
];
---

<BaseLayout
  title="Employee Engagement Survey | Incentric CX"
  description="Employee Engagement Survey by Incentric helps companies understand team engagement through Q12-inspired measurement, analysis, and practical recommendations."
>
  <main id="top" class="min-h-screen overflow-hidden bg-[#e7eaee] text-slate-950">
    <Navbar theme="light" client:load />

    <section class="relative border-b border-slate-300/70 px-6 pb-16 pt-32 md:pt-40 lg:px-10">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[minmax(0,1.04fr)_minmax(380px,0.96fr)] lg:items-center">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.24em] text-brand-blue">Employee Engagement Survey</p>
          <h1 class="mt-6 max-w-5xl text-5xl font-bold leading-[0.98] tracking-tight text-slate-950 md:text-7xl lg:text-[5.75rem]">
            Seberapa engaged karyawan Anda?
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-relaxed text-slate-600 md:text-xl">
            Karyawan yang engaged bukan sekadar hadir dan mengerjakan tugas. Mereka bekerja dengan inisiatif, peduli pada hasil, dan mau memberikan lebih dari yang diminta.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={WHATSAPP_URL} target="_blank" rel="noreferrer" class="inline-flex min-h-12 items-center justify-center rounded-full bg-slate-950 px-6 py-3 text-sm font-bold text-white transition hover:bg-brand-blue">
              Hubungi Kami
            </a>
            <a href="#framework" class="inline-flex min-h-12 items-center justify-center rounded-full border border-slate-400 px-6 py-3 text-sm font-bold text-slate-950 transition hover:border-brand-blue hover:text-brand-blue">
              Lihat Framework
            </a>
          </div>
        </div>

        <aside class="rounded-lg border border-slate-950 bg-slate-950 p-5 text-white shadow-[0_24px_80px_rgba(15,23,42,0.22)]">
          <div class="flex items-start justify-between gap-6 border-b border-white/10 pb-5">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-yellow">Business Signal</p>
              <p class="mt-3 text-2xl font-bold leading-tight">Engagement bukan mood. Ini leading indicator performa.</p>
            </div>
            <span class="rounded-md bg-brand-yellow px-3 py-1.5 text-sm font-black text-slate-950">Q12</span>
          </div>
          <div class="grid gap-4 py-6 sm:grid-cols-2">
            <div class="border-l-4 border-brand-yellow pl-4">
              <p class="text-5xl font-black tracking-tight text-brand-yellow">147%</p>
              <p class="mt-2 text-sm font-semibold leading-snug text-white/70">pertumbuhan pendapatan pada perusahaan dengan engagement tinggi</p>
            </div>
            <div class="border-l-4 border-brand-blue pl-4">
              <p class="text-5xl font-black tracking-tight text-white">23%</p>
              <p class="mt-2 text-sm font-semibold leading-snug text-white/70">peningkatan profitabilitas yang terhubung dengan engagement</p>
            </div>
          </div>
          <p class="border-t border-white/10 pt-5 text-sm font-semibold leading-relaxed text-white/70">
            Berdasarkan temuan Gallup. Angka ini menjadi pengingat bahwa kondisi internal tim berpengaruh langsung pada kualitas layanan, retensi, dan pertumbuhan bisnis.
          </p>
        </aside>
      </div>
    </section>

    <section class="px-6 py-16 lg:px-10 lg:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <div class="lg:sticky lg:top-28">
          <p class="text-sm font-bold uppercase tracking-[0.24em] text-brand-blue">Why It Matters</p>
          <h2 class="mt-5 text-4xl font-bold leading-tight tracking-tight md:text-6xl">
            Yang tidak terlihat sering menjadi biaya terbesar.
          </h2>
        </div>
        <div class="grid gap-5 md:grid-cols-2">
          <article class="rounded-lg border border-slate-300 bg-white p-6">
            <p class="text-4xl font-black text-brand-blue">01</p>
            <h3 class="mt-5 text-2xl font-bold tracking-tight">Produktivitas rendah</h3>
            <p class="mt-3 leading-relaxed text-slate-600">Tim tetap hadir, tetapi energi, inisiatif, dan kualitas eksekusinya tidak bergerak searah dengan target bisnis.</p>
          </article>
          <article class="rounded-lg border border-slate-300 bg-white p-6">
            <p class="text-4xl font-black text-brand-blue">02</p>
            <h3 class="mt-5 text-2xl font-bold tracking-tight">Service asal-asalan</h3>
            <p class="mt-3 leading-relaxed text-slate-600">Engagement internal yang lemah sering terasa langsung oleh pelanggan melalui respons, empati, dan konsistensi layanan.</p>
          </article>
          <article class="rounded-lg border border-slate-300 bg-white p-6">
            <p class="text-4xl font-black text-brand-blue">03</p>
            <h3 class="mt-5 text-2xl font-bold tracking-tight">Turnover mahal</h3>
            <p class="mt-3 leading-relaxed text-slate-600">Biaya rekrutmen, onboarding, pelatihan, dan kehilangan pengetahuan tim sering muncul setelah masalahnya terlambat dibaca.</p>
          </article>
          <article class="rounded-lg border border-slate-950 bg-brand-yellow p-6">
            <p class="text-4xl font-black text-slate-950">?</p>
            <h3 class="mt-5 text-2xl font-bold tracking-tight">Pertanyaan utamanya</h3>
            <p class="mt-3 leading-relaxed text-slate-800">Bagaimana Anda tahu kondisi sebenarnya di dalam tim sebelum dampaknya terlihat di angka bisnis?</p>
          </article>
        </div>
      </div>
    </section>

    <section id="framework" class="bg-slate-950 px-6 py-16 text-white lg:px-10 lg:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.24em] text-brand-yellow">Q12-Inspired Method</p>
            <h2 class="mt-5 text-4xl font-bold leading-tight tracking-tight text-white md:text-6xl">
              Dengarkan suara tim Anda dengan data.
            </h2>
          </div>
          <p class="max-w-2xl text-lg leading-relaxed text-white/68">
            Incentric menghadirkan Employee Engagement Survey yang diadaptasi dari metodologi Q12 milik Gallup. Survey ini mengukur empat aspek utama yang benar-benar menentukan kondisi tim Anda.
          </p>
        </div>

        <div class="mt-12 grid gap-5 md:grid-cols-2">
          {dimensions.map((item, index) => (
            <article class="rounded-lg border border-white/10 bg-white/[0.045] p-6">
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-2xl font-bold tracking-tight text-white">{item.label}</h3>
                <span class="rounded-md bg-brand-yellow px-2.5 py-1 text-xs font-black text-slate-950">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>
              <p class="mt-5 text-lg font-bold leading-snug text-white">{item.question}</p>
              <p class="mt-4 leading-relaxed text-white/62">{item.note}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-6 py-16 lg:px-10 lg:py-24">
      <div class="mx-auto max-w-7xl">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.24em] text-brand-blue">What You Get</p>
          <div class="mt-5 grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-end">
            <h2 class="max-w-4xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">
              Bukan sekadar angka. Ini peta keputusan.
            </h2>
            <p class="max-w-2xl text-lg leading-relaxed text-slate-600 lg:justify-self-end">
              Hasil survey disajikan dalam laporan yang mudah dipahami, lengkap dengan analisis dan rekomendasi langkah konkret untuk tim dan bisnis Anda.
            </p>
          </div>
        </div>

        <div class="mt-12 grid gap-6 lg:grid-cols-12 lg:items-stretch">
          <div class="grid gap-4 md:grid-cols-2 lg:col-span-7">
            {process.map(([number, title, copy]) => (
              <article class="flex min-h-[210px] flex-col justify-between rounded-lg border border-slate-300 bg-white p-5">
                <div class="flex items-start justify-between gap-4">
                  <h3 class="max-w-[14rem] text-xl font-bold leading-tight tracking-tight">{title}</h3>
                  <p class="shrink-0 text-3xl font-black text-brand-blue">{number}</p>
                </div>
                <p class="mt-8 leading-relaxed text-slate-600">{copy}</p>
              </article>
            ))}
          </div>

          <aside class="flex flex-col rounded-lg border border-slate-950 bg-white p-6 shadow-[0_20px_70px_rgba(15,23,42,0.14)] lg:col-span-5">
            <div class="border-b border-slate-200 pb-5">
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-blue">Sample Report View</p>
              <h3 class="mt-3 text-3xl font-bold tracking-tight">Engagement Heatmap</h3>
              <p class="mt-3 leading-relaxed text-slate-600">
                Ringkasan visual membantu leadership melihat prioritas tanpa harus membaca data mentah satu per satu.
              </p>
            </div>
            <div class="mt-6 flex-1 space-y-5">
              <div>
                <div class="mb-2 flex justify-between text-sm font-bold">
                  <span>Basic Needs</span>
                  <span>82</span>
                </div>
                <div class="h-3 overflow-hidden rounded-full bg-slate-200"><div class="h-full w-[82%] rounded-full bg-brand-blue"></div></div>
              </div>
              <div>
                <div class="mb-2 flex justify-between text-sm font-bold">
                  <span>Individual Contribution</span>
                  <span>68</span>
                </div>
                <div class="h-3 overflow-hidden rounded-full bg-slate-200"><div class="h-full w-[68%] rounded-full bg-brand-yellow"></div></div>
              </div>
              <div>
                <div class="mb-2 flex justify-between text-sm font-bold">
                  <span>Teamwork</span>
                  <span>74</span>
                </div>
                <div class="h-3 overflow-hidden rounded-full bg-slate-200"><div class="h-full w-[74%] rounded-full bg-slate-950"></div></div>
              </div>
              <div>
                <div class="mb-2 flex justify-between text-sm font-bold">
                  <span>Growth</span>
                  <span>56</span>
                </div>
                <div class="h-3 overflow-hidden rounded-full bg-slate-200"><div class="h-full w-[56%] rounded-full bg-slate-500"></div></div>
              </div>
            </div>
            <div class="mt-8 rounded-lg bg-slate-950 p-5 text-white">
              <p class="text-sm font-bold uppercase tracking-[0.18em] text-brand-yellow">Priority Insight</p>
              <p class="mt-3 text-lg font-bold leading-snug">Growth menjadi area intervensi utama: karyawan perlu melihat jalur perkembangan yang lebih jelas.</p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="border-y border-slate-300 bg-white px-6 py-16 lg:px-10 lg:py-20">
      <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.24em] text-brand-blue">Start with Clarity</p>
          <h2 class="mt-5 max-w-4xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">
            Membangun tim yang engaged bukan tentang menebak-nebak.
          </h2>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600">
            Ini tentang memahami, lalu bertindak dengan tepat. Konsultasikan kebutuhan survey Anda secara gratis bersama tim Incentric.
          </p>
        </div>
        <a href={WHATSAPP_URL} target="_blank" rel="noreferrer" class="inline-flex min-h-14 items-center justify-center rounded-full bg-brand-yellow px-8 py-4 text-sm font-black uppercase tracking-[0.12em] text-slate-950 transition hover:bg-yellow-300">
          Hubungi Kami
        </a>
      </div>
    </section>

    <Footer client:load />
  </main>
</BaseLayout>
