---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Services | Incentric CX"
  description="Explore Incentric services for customer experience strategy, service design, and growth improvement."
>
  <main class="brand-page brand-main">
    <div class="brand-container--narrow">
      <a href="/" class="brand-link">Back to home</a>
      <section class="brand-section-header mt-8">
        <p class="brand-kicker">Services</p>
        <h1 class="brand-display">
          Customer experience services for measurable growth.
        </h1>
        <p class="brand-copy mt-6">
          We help diagnose customer issues, design better experiences, and guide implementation across service, CRM, and growth systems.
        </p>
      </section>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <article class="brand-card">
          <p class="brand-card-number">01</p>
          <h2 class="brand-subheading mt-4">Business & Customer Diagnosis</h2>
          <p class="brand-copy mt-3 text-base">
            Identify customer pain points, operational blind spots, and priority improvements.
          </p>
        </article>
        <article class="brand-card">
          <p class="brand-card-number">02</p>
          <h2 class="brand-subheading mt-4">Strategy & Experience Design</h2>
          <p class="brand-copy mt-3 text-base">
            Shape customer strategies, journeys, and service standards that teams can execute.
          </p>
        </article>
        <article class="brand-card">
          <p class="brand-card-number">03</p>
          <h2 class="brand-subheading mt-4">Implementation & Growth Improvement</h2>
          <p class="brand-copy mt-3 text-base">
            Turn strategy into measurable service quality, loyalty, and sustainable business growth.
          </p>
        </article>
      </div>
    </div>
  </main>
</BaseLayout>
