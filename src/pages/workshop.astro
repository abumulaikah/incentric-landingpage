---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Workshop | Incentric CX"
  description="Incentric workshops help teams align around customer experience, service culture, and practical growth execution."
>
  <main class="brand-page brand-page--dark brand-main">
    <div class="brand-container--narrow">
      <a href="/" class="brand-link">Back to home</a>
      <section class="brand-section-header mt-8">
        <p class="brand-kicker">Workshop</p>
        <h1 class="brand-display text-white">
          Practical sessions for customer-centered teams.
        </h1>
        <p class="brand-copy mt-6">
          Workshops designed to help leaders and teams understand customers, improve service behavior, and build repeatable execution habits.
        </p>
      </section>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <article class="brand-card">
          <h2 class="brand-subheading text-white">WOW Experience Loop</h2>
          <p class="brand-copy mt-3 text-base">
            Align product, service, marketing, culture, management, and leadership around loyal customers.
          </p>
        </article>
        <article class="brand-card">
          <h2 class="brand-subheading text-white">Service Culture</h2>
          <p class="brand-copy mt-3 text-base">
            Build shared service principles and daily team behaviors that customers can feel.
          </p>
        </article>
        <article class="brand-card">
          <h2 class="brand-subheading text-white">Growth Execution</h2>
          <p class="brand-copy mt-3 text-base">
            Translate workshop outcomes into priorities, rituals, and measurable next steps.
          </p>
        </article>
      </div>
    </div>
  </main>
</BaseLayout>
