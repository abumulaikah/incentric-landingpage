---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Workshop | Incentric CX"
  description="Incentric workshops help teams align around customer experience, service culture, and practical growth execution."
>
  <main class="min-h-screen bg-slate-950 px-6 py-24 text-white">
    <div class="mx-auto max-w-5xl">
      <a href="/" class="text-sm font-bold text-brand-yellow hover:underline">Back to home</a>
      <section class="mt-8 border-b border-white/10 pb-10">
        <p class="text-sm font-bold uppercase tracking-[0.3em] text-brand-yellow">Workshop</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight md:text-6xl">
          Practical sessions for customer-centered teams.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
          Workshops designed to help leaders and teams understand customers, improve service behavior, and build repeatable execution habits.
        </p>
      </section>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <article class="rounded-lg border border-white/10 bg-white/5 p-6">
          <h2 class="text-2xl font-bold">WOW Experience Loop</h2>
          <p class="mt-3 leading-relaxed text-slate-300">
            Align product, service, marketing, culture, management, and leadership around loyal customers.
          </p>
        </article>
        <article class="rounded-lg border border-white/10 bg-white/5 p-6">
          <h2 class="text-2xl font-bold">Service Culture</h2>
          <p class="mt-3 leading-relaxed text-slate-300">
            Build shared service principles and daily team behaviors that customers can feel.
          </p>
        </article>
        <article class="rounded-lg border border-white/10 bg-white/5 p-6">
          <h2 class="text-2xl font-bold">Growth Execution</h2>
          <p class="mt-3 leading-relaxed text-slate-300">
            Translate workshop outcomes into priorities, rituals, and measurable next steps.
          </p>
        </article>
      </div>
    </div>
  </main>
</BaseLayout>
